  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ClubIdentity, UserProfile } from \'../types\';\nimport { \n  Trophy, \n  Atom, \n  FlaskConical, \n  Menu, \n  X, \n  Layers, \n  Sparkles, \n  HelpCircle, \n  Calendar,\n  Compass,\n  BookOpen,\n  Image as ImageIcon\n} from \'lucide-react\';\n\ninterface HeaderProps {\n  currentTab: string;\n  setCurrentTab: (tab: string) => void;\n  identity: ClubIdentity;\n  setIdentity: (id: ClubIdentity) => void;\n  userProfile: UserProfile;\n  onOpenJoin: () => void;\n}\n\nexport default function Header({\n  currentTab,\n  setCurrentTab,\n  identity,\n  setIdentity,\n  userProfile,\n  onOpenJoin\n}: HeaderProps) {\n  const [menuOpen, setMenuOpen] = useState(false);\n\n  const isTurtle = identity === \'turtlerock\';\n\n  const navItems = [\n    { id: \'missions\', label: \'Missions\', icon: Calendar },\n    { id: \'lab\', label: \'Interactive Lab\', icon: FlaskConical },\n    { id: \'logs\', label: \'Lab Log & Announcements\', icon: BookOpen },\n    { id: \'gallery\', label: \'Our Gallery\', icon: ImageIcon },\n    { id: \'about\', label: \'About Us & FAQs\', icon: HelpCircle }\n  ];\n\n  return (\n    <header className={`sticky top-0 z-40 transition-all duration-300 border-b backdrop-blur-md ${\n      isTurtle \n        ? \'bg-emerald-50/90 border-emerald-100 text-emerald-900\' \n        : \'bg-slate-900/90 border-slate-800 text-slate-100\'\n    }`}>\n      {/* Top Banner for Switching Club Identities */}\n      <div className={`text-xs py-1.5 px-4 text-center font-medium tracking-wide flex items-center justify-center gap-2 transition-all duration-300 ${\n        isTurtle \n          ? \'bg-emerald-600 text-white\' \n          : \'bg-indigo-600 text-white\'\n      }`}>\n        <span>You are exploring the <strong className=\"font-bold\">{isTurtle ? \'Turtle Rock Science Club\' : \'Kinetic Lab Discovery\'}</strong> blueprint.</span>\n        <button \n          id=\"identity-toggle-btn\"\n          onClick={() => setIdentity(isTurtle ? \'kinetic\' : \'turtlerock\')}\n          className=\"px-2.5 py-0.5 rounded-full bg-white text-xs font-semibold shadow-xs hover:scale-105 active:scale-95 transition-all flex items-center gap-1 cursor-pointer\"\n          style={{ color: isTurtle ? \'#059669\' : \'#4f46e5\' }}\n        >\n          <Layers className=\"w-3 h-3\" />\n          Switch to {isTurtle ? \'\342\232\241 Kinetic Lab\' : \'\360\237\220\242 Turtle Rock\'}\n        </button>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          \n          {/* Brand/Logo */}\n          <button \n            id=\"brand-logo-btn\"\n            onClick={() => setCurrentTab(\'missions\')} \n            className=\"flex items-center gap-2.5 group cursor-pointer text-left\"\n          >\n            <div className={`p-2 rounded-xl transition-all duration-300 ${\n              isTurtle \n                ? \'bg-emerald-100 text-emerald-700 group-hover:bg-emerald-200\' \n                : \'bg-indigo-950 text-indigo-400 group-hover:bg-indigo-900\'\n            }`}>\n              {isTurtle ? (\n                <span className=\"text-xl\">\360\237\220\242</span>\n              ) : (\n                <Atom className=\"w-6 h-6 animate-spin-slow\" />\n              )}\n            </div>\n            <div>\n              <h1 className=\"font-display font-bold text-lg leading-tight tracking-tight\">\n                {isTurtle ? \'Turtle Rock\' : \'Kinetic Lab\'}\n              </h1>\n              <p className={`text-[10px] font-mono tracking-wider uppercase font-medium ${\n                isTurtle ? \'text-emerald-600\' : \'text-indigo-400\'\n              }`}>\n                {isTurtle ? \'Science Club\' : \'Discovery Lab\'}\n              </p>\n            </div>\n          </button>\n\n          {/* Desktop Navigation */}\n          <nav className=\"hidden lg:flex items-center gap-1\" id=\"desktop-nav\">\n            {navItems.map((item) => {\n              const Icon = item.icon;\n              const isActive = currentTab === item.id;\n              return (\n                <button\n                  id={`nav-item-${item.id}`}\n                  key={item.id}\n                  onClick={() => setCurrentTab(item.id)}\n                  className={`px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200 flex items-center gap-1.5 cursor-pointer hover:bg-opacity-10 ${\n                    isActive\n                      ? isTurtle\n                        ? \'bg-emerald-200/80 text-emerald-900 shadow-xs\'\n                        : \'bg-indigo-600 text-white shadow-xs\'\n                      : isTurtle\n                        ? \'text-emerald-700 hover:bg-emerald-100/70\'\n                        : \'text-slate-300 hover:bg-slate-800\'\n                  }`}\n                >\n                  <Icon className=\"w-4 h-4\" />\n                  {item.label}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* User Profile / Join CTA */}\n          <div className=\"hidden sm:flex items-center gap-3\">\n            {userProfile.level > 0 ? (\n              <button\n                id=\"header-profile-btn\"\n                onClick={() => setCurrentTab(\'dashboard\')}\n                className={`flex items-center gap-2.5 pl-2.5 pr-4 py-1.5 rounded-full text-xs font-mono font-medium transition-all cursor-pointer ${\n                  isTurtle\n                    ? \'bg-emerald-100 hover:bg-emerald-200 text-emerald-800 border border-emerald-200\'\n                    : \'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700\'\n                }`}\n              >\n                <div className=\"w-6 h-6 rounded-full bg-indigo-500 text-white flex items-center justify-center font-bold text-xs ring-2 ring-indigo-300\">\n                  {userProfile.name[0].toUpperCase()}\n                </div>\n                <div className=\"text-left\">\n                  <p className=\"font-semibold leading-none\">{userProfile.name}</p>\n                  <p className=\"text-[9px] opacity-75 flex items-center gap-1 mt-0.5\">\n                    <Trophy className=\"w-2.5 h-2.5 text-yellow-500\" />\n                    Lvl {userProfile.level} \342\200\242 {userProfile.reservedMissionIds.length} Reserved\n                  </p>\n                </div>\n              </button>\n            ) : (\n              <button\n                id=\"header-join-btn\"\n                onClick={onOpenJoin}\n                className={`px-4 py-2 rounded-xl text-sm font-semibold shadow-md transition-all duration-300 hover:shadow-lg hover:scale-[1.02] active:scale-95 cursor-pointer ${\n                  isTurtle\n                    ? \'bg-amber-500 text-stone-900 hover:bg-amber-400\'\n                    : \'bg-indigo-600 text-white hover:bg-indigo-500\'\n                }`}\n              >\n                Join the Club\n              </button>\n            )}\n          </div>\n\n          {/* Mobile Menu Toggle */}\n          <div className=\"lg:hidden flex items-center gap-2\">\n            {/* Quick dashboard profile link on mobile */}\n            {userProfile.level > 0 && (\n              <button\n                id=\"mobile-profile-quick-btn\"\n                onClick={() => setCurrentTab(\'dashboard\')}\n                className=\"w-8 h-8 rounded-full bg-indigo-500 text-white flex items-center justify-center font-bold text-sm ring-2 ring-indigo-300 cursor-pointer\"\n              >\n                {userProfile.name[0].toUpperCase()}\n              </button>\n            )}\n            \n            <button\n              id=\"mobile-menu-toggle-btn\"\n              onClick={() => setMenuOpen(!menuOpen)}\n              className={`p-2 rounded-lg cursor-pointer ${\n                isTurtle ? \'hover:bg-emerald-100 text-emerald-800\' : \'hover:bg-slate-800 text-slate-200\'\n              }`}\n            >\n              {menuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Mobile Menu Drawer */}\n      {menuOpen && (\n        <div id=\"mobile-nav-drawer\" className={`lg:hidden border-t px-4 py-3 space-y-2 animate-fade-in ${\n          isTurtle ? \'bg-emerald-50 border-emerald-100\' : \'bg-slate-900 border-slate-800\'\n        }`}>\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                id={`mobile-nav-item-${item.id}`}\n                key={item.id}\n                onClick={() => {\n                  setCurrentTab(item.id);\n                  setMenuOpen(false);\n                }}\n                className={`w-full text-left px-4 py-2.5 rounded-lg text-sm font-medium flex items-center gap-3 cursor-pointer ${\n                  isActive\n                    ? isTurtle\n                      ? \'bg-emerald-200 text-emerald-900\'\n                      : \'bg-indigo-600 text-white\'\n                    : isTurtle\n                      ? \'text-emerald-800 hover:bg-emerald-100\'\n                      : \'text-slate-300 hover:bg-slate-800\'\n                }`}\n              >\n                <Icon className=\"w-4 h-4\" />\n                {item.label}\n              </button>\n            );\n          })}\n\n          {userProfile.level === 0 && (\n            <div className=\"pt-2 border-t border-dashed mt-2 border-emerald-200/50\">\n              <button\n                id=\"mobile-join-btn\"\n                onClick={() => {\n                  onOpenJoin();\n                  setMenuOpen(false);\n                }}\n                className={`w-full py-2.5 rounded-lg text-center text-sm font-semibold shadow-xs cursor-pointer ${\n                  isTurtle\n                    ? \'bg-amber-500 text-stone-900 hover:bg-amber-400\'\n                    : \'bg-indigo-600 text-white hover:bg-indigo-500\'\n                }`}\n              >\n                Join the Club\n              </button>\n            </div>\n          )}\n        </div>\n      )}\n    </header>\n  );\n}\n"
    }
