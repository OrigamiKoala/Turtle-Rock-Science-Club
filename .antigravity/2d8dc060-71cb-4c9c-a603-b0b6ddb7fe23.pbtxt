    instruction: "Restyle PhotoGallery to apply Bento Grid design and dark glassy components."
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <section className=\"py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto\">\n      \n      {/* Header and top info */}\n      <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4\">\n        <div>\n          <h3 className={`font-display font-bold text-2xl sm:text-3xl tracking-tight ${\n            isTurtle ? \'text-emerald-900\' : \'text-slate-100\'\n          }`}>\n            Our Gallery & Community Moments\n          </h3>\n          <p className={`text-sm mt-1.5 ${isTurtle ? \'text-stone-600\' : \'text-slate-400\'}`}>\n            Witness the spark of curiosity in action! Browse through real moments captured during our basecamp experiments and geological hikes.\n          </p>\n        </div>\n\n        {/* Action to show form */}\n        <button\n          id=\"toggle-submit-photo-btn\"\n          onClick={() => {\n            if (!isJoined) {\n              onOpenJoin();\n            } else {\n              setShowSubmitForm(!showSubmitForm);\n            }\n          }}\n          className={`px-4 py-2.5 rounded-xl text-xs font-bold shadow-md hover:shadow-lg transition flex items-center gap-2 cursor-pointer ${\n            isTurtle\n              ? \'bg-emerald-600 text-white hover:bg-emerald-500\'\n              : \'bg-indigo-600 text-white hover:bg-indigo-500\'\n          }`}\n        >\n          {showSubmitForm ? \'Hide Submission Box\' : \'Submit Lab Photo\'}\n          <Camera className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Submitting form widget */}\n      {showSubmitForm && (\n        <div className={`p-6 rounded-2xl border mb-8 animate-fade-in ${\n          isTurtle ? \'bg-emerald-50/70 border-emerald-200\' : \'bg-slate-900 border-slate-800 text-slate-100\'\n        }`}>\n          <h4 className=\"font-display font-bold text-lg mb-4 flex items-center gap-2\">\n            <Upload className=\"w-5 h-5\" />\n            Upload Photo to Club Gallery\n          </h4>\n\n          {submitSuccess ? (\n            <div className=\"py-8 flex flex-col items-center justify-center text-center space-y-2\">\n              <CheckCircle className=\"w-12 h-12 text-emerald-500 fill-emerald-100\" />\n              <p className=\"font-bold text-emerald-800 text-base\">Photo Successfully Added!</p>\n              <p className=\"text-xs text-stone-500\">Your community contribution is now live on the photo grid below.</p>\n            </div>\n          ) : (\n            <form onSubmit={handleFormSubmit} className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                \n                {/* Inputs */}\n                <div className=\"space-y-4\">\n                  <div className=\"space-y-1\">\n                    <label className=\"text-xs font-bold font-mono\">Photo Title</label>\n                    <input\n                      id=\"photo-title-input\"\n                      type=\"text\"\n                      placeholder=\"e.g. Baking Soda foam splash\"\n                      value={title}\n                      onChange={(e) => setTitle(e.target.value)}\n                      className={`w-full p-2.5 rounded-xl text-xs border ${\n                        isTurtle ? \'bg-white border-emerald-200\' : \'bg-slate-950 border-slate-800 text-slate-100\'\n                      }`}\n                      required\n                    />\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"text-xs font-bold font-mono\">Description / Caption</label>\n                    <textarea\n                      id=\"photo-desc-input\"\n                      placeholder=\"e.g. Timmy (Age 8) calibrating his lava bottle with organic blue watercolors.\"\n                      value={description}\n                      onChange={(e) => setDescription(e.target.value)}\n                      rows={3}\n                      className={`w-full p-2.5 rounded-xl text-xs border ${\n                        isTurtle ? \'bg-white border-emerald-200\' : \'bg-slate-950 border-slate-800 text-slate-100\'\n                      }`}\n                      required\n                    />\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"text-xs font-bold font-mono\">Category Tag</label>\n                    <select\n                      id=\"photo-category-select\"\n                      value={category}\n                      onChange={(e) => setCategory(e.target.value as any)}\n                      className={`w-full p-2.5 rounded-xl text-xs border ${\n                        isTurtle ? \'bg-white border-emerald-200\' : \'bg-slate-950 border-slate-800 text-slate-100\'\n                      }`}\n                    >\n                      <option value=\"experiments\">Experiments</option>\n                      <option value=\"field-trips\">Field Trips</option>\n                      <option value=\"lab-meetings\">Lab Meetings</option>\n                    </select>\n                  </div>\n                </div>\n\n                {/* File picker drop area */}\n                <div className=\"flex flex-col items-center justify-center border-2 border-dashed border-stone-300 rounded-2xl p-4 relative min-h-[200px]\">\n                  {selectedFileUrl ? (\n                    <div className=\"w-full h-full flex flex-col items-center justify-center space-y-2\">\n                      <img src={selectedFileUrl} alt=\"Preview\" className=\"max-h-36 rounded-lg object-contain\" />\n                      <button\n                        type=\"button\"\n                        onClick={() => setSelectedFileUrl(null)}\n                        className=\"text-[10px] text-red-500 hover:underline\"\n                      >\n                        Change Photo\n                      </button>\n                    </div>\n                  ) : (\n                    <div className=\"text-center space-y-2\">\n                      <div className=\"p-3 rounded-full bg-slate-100 text-slate-500 inline-block\">\n                        <Upload className=\"w-6 h-6\" />\n                      </div>\n                      <p className=\"text-xs font-semibold\">Select or drag an image</p>\n                      <p className=\"text-[10px] text-stone-400\">Supports JPG, PNG up to 2MB</p>\n                      <input\n                        id=\"photo-file-upload-input\"\n                        type=\"file\"\n                        accept=\"image/*\"\n                        onChange={handleFileChange}\n                        className=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\"\n                        required\n                      />\n                    </div>\n                  )}\n                </div>\n\n              </div>\n\n              {submitError && (\n                <div className=\"flex items-center gap-2 text-xs text-red-500 font-mono\">\n                  <AlertCircle className=\"w-4 h-4\" />\n                  <span>{submitError}</span>\n                </div>\n              )}\n\n              <button\n                id=\"photo-submit-btn\"\n                type=\"submit\"\n                className={`w-full py-2.5 rounded-xl text-xs font-bold transition cursor-pointer ${\n                  isTurtle\n                    ? \'bg-amber-500 hover:bg-amber-400 text-stone-900\'\n                    : \'bg-indigo-600 hover:bg-indigo-500 text-white\'\n                }`}\n              >\n                Publish Photo\n              </button>\n            </form>\n          )}\n        </div>\n      )}\n\n      {/* Filter tabs */}\n      <div className=\"flex items-center gap-2 mb-6 overflow-x-auto pb-2\" id=\"gallery-filters\">\n        <Filter className=\"w-4 h-4 text-stone-400 shrink-0\" />\n        {[\n          { id: \'all\', label: \'All Moments\' },\n          { id: \'experiments\', label: \'Experiments\' },\n          { id: \'field-trips\', label: \'Field Trips\' },\n          { id: \'lab-meetings\', label: \'Lab Meetings\' }\n        ].map((f) => {\n          const isActive = activeFilter === f.id;\n          return (\n            <button\n              id={`gallery-filter-${f.id}`}\n              key={f.id}\n              onClick={() => setActiveFilter(f.id as any)}\n              className={`px-3 py-1.5 rounded-full text-xs font-medium shrink-0 transition cursor-pointer ${\n                isActive\n                  ? isTurtle \n                    ? \'bg-emerald-600 text-white\' \n                    : \'bg-indigo-600 text-white\'\n                  : isTurtle\n                    ? \'bg-emerald-50 text-emerald-800 hover:bg-emerald-100 border border-emerald-100\'\n                    : \'bg-slate-800 text-slate-300 hover:bg-slate-700 border border-slate-700\'\n              }`}\n            >\n              {f.label}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Grid of Photo Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {filteredPhotos.map((photo) => (\n          <div\n            id={`gallery-card-${photo.id}`}\n            key={photo.id}\n            className={`rounded-2xl overflow-hidden border transition-all duration-300 flex flex-col justify-between ${\n              isTurtle \n                ? \'bg-white border-emerald-100 shadow-sm hover:shadow-md\' \n                : \'bg-slate-900 border-slate-800/80 shadow-md text-slate-100\'\n            }`}\n          >\n            {/* Visual Header */}\n            <div className=\"relative h-56 overflow-hidden\">\n              <img\n                src={photo.imageUrl}\n                alt={photo.title}\n                className=\"w-full h-full object-cover transition-transform duration-500 hover:scale-[1.03]\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className={`absolute bottom-3 left-3 px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wide shadow-xs ${\n                photo.category === \'experiments\' \n                  ? \'bg-amber-500 text-stone-900\' \n                  : photo.category === \'field-trips\'\n                    ? \'bg-blue-500 text-white\'\n                    : \'bg-indigo-500 text-white\'\n              }`}>\n                {photo.category.replace(\'-\', \' \')}\n              </span>\n            </div>\n\n            {/* Description Body */}\n            <div className=\"p-4 space-y-3 flex-1 flex flex-col justify-between\">\n              <div className=\"space-y-1\">\n                <h4 className=\"font-display font-bold text-base leading-snug tracking-tight\">\n                  {photo.title}\n                </h4>\n                <p className={`text-xs leading-relaxed ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n                  {photo.description}\n                </p>\n              </div>\n\n              {/* Attribution */}\n              <div className={`pt-2.5 border-t text-[10px] font-mono flex items-center justify-between ${\n                isTurtle ? \'border-emerald-50 text-emerald-800\' : \'border-slate-800 text-slate-400\'\n              }`}>\n                <span>By: {photo.submittedBy}</span>\n                <span>{photo.date}</span>\n              </div>\n            </div>\n\n          </div>\n        ))}\n      </div>\n\n      {filteredPhotos.length === 0 && (\n        <div className=\"text-center py-16 border border-dashed border-stone-200 rounded-2xl\">\n          <ImageIcon className=\"w-12 h-12 text-stone-300 mx-auto mb-2\" />\n          <p className=\"font-semibold text-stone-500\">No moments recorded in this tag yet</p>\n          <p className=\"text-xs text-stone-400\">Join the club, perform virtual experiments, and upload your first snapshot!</p>\n        </div>\n      )}\n\n    </section>\n  );"
        replacement_content: "  return (\n    <section className=\"py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative z-10 font-sans\">\n      \n      {/* Header and top info */}\n      <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4\">\n        <div>\n          <h3 className=\"font-display font-bold text-2xl sm:text-3xl tracking-tighter text-white\">\n            Our Gallery & Community Moments\n          </h3>\n          <p className=\"text-xs text-zinc-400 mt-1.5 max-w-2xl font-sans\">\n            Witness the spark of curiosity in action! Browse through real moments captured during our basecamp experiments and geological hikes.\n          </p>\n        </div>\n\n        {/* Action to show form */}\n        <button\n          id=\"toggle-submit-photo-btn\"\n          onClick={() => {\n            if (!isJoined) {\n              onOpenJoin();\n            } else {\n              setShowSubmitForm(!showSubmitForm);\n            }\n          }}\n          className=\"px-4 py-2.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-widest border border-white/10 bg-white/5 hover:bg-white/10 text-zinc-300 transition flex items-center gap-2 cursor-pointer shrink-0\"\n        >\n          <span>{showSubmitForm ? \'Hide Submission Box\' : \'Submit Lab Photo\'}</span>\n          <Camera className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n\n      {/* Submitting form widget */}\n      {showSubmitForm && (\n        <div className=\"p-6 rounded-[2rem] border border-white/10 bg-zinc-900/40 backdrop-blur-md mb-8 text-white animate-fade-in\">\n          <h4 className=\"font-display font-bold text-base mb-4 flex items-center gap-2 text-white\">\n            <Upload className=\"w-4 h-4 text-zinc-400\" />\n            Upload Photo to Club Gallery\n          </h4>\n\n          {submitSuccess ? (\n            <div className=\"py-8 flex flex-col items-center justify-center text-center space-y-2\">\n              <CheckCircle className=\"w-12 h-12 text-emerald-500 fill-emerald-950\" />\n              <p className=\"font-bold text-emerald-400 text-sm font-mono uppercase tracking-wider\">Photo Successfully Added!</p>\n              <p className=\"text-xs text-zinc-400\">Your community contribution is now live on the photo grid below.</p>\n            </div>\n          ) : (\n            <form onSubmit={handleFormSubmit} className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                \n                {/* Inputs */}\n                <div className=\"space-y-4\">\n                  <div className=\"space-y-1\">\n                    <label className=\"text-[10px] font-bold font-mono uppercase tracking-widest text-zinc-500\">Photo Title</label>\n                    <input\n                      id=\"photo-title-input\"\n                      type=\"text\"\n                      placeholder=\"e.g. Baking Soda foam splash\"\n                      value={title}\n                      onChange={(e) => setTitle(e.target.value)}\n                      className=\"w-full p-2.5 rounded-xl text-xs border border-white/10 bg-zinc-950/60 text-white focus:outline-none focus:border-white/20\"\n                      required\n                    />\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"text-[10px] font-bold font-mono uppercase tracking-widest text-zinc-500\">Description / Caption</label>\n                    <textarea\n                      id=\"photo-desc-input\"\n                      placeholder=\"e.g. Timmy (Age 8) calibrating his lava bottle with organic blue watercolors.\"\n                      value={description}\n                      onChange={(e) => setDescription(e.target.value)}\n                      rows={3}\n                      className=\"w-full p-2.5 rounded-xl text-xs border border-white/10 bg-zinc-950/60 text-white focus:outline-none focus:border-white/20 resize-none\"\n                      required\n                    />\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"text-[10px] font-bold font-mono uppercase tracking-widest text-zinc-500\">Category Tag</label>\n                    <select\n                      id=\"photo-category-select\"\n                      value={category}\n                      onChange={(e) => setCategory(e.target.value as any)}\n                      className=\"w-full p-2.5 rounded-xl text-xs border border-white/10 bg-zinc-950/60 text-white focus:outline-none focus:border-white/20\"\n                    >\n                      <option value=\"experiments\" className=\"bg-zinc-950\">Experiments</option>\n                      <option value=\"field-trips\" className=\"bg-zinc-950\">Field Trips</option>\n                      <option value=\"lab-meetings\" className=\"bg-zinc-950\">Lab Meetings</option>\n                    </select>\n                  </div>\n                </div>\n\n                {/* File picker drop area */}\n                <div className=\"flex flex-col items-center justify-center border-2 border-dashed border-white/10 rounded-2xl p-4 bg-zinc-950/40 relative min-h-[200px]\">\n                  {selectedFileUrl ? (\n                    <div className=\"w-full h-full flex flex-col items-center justify-center space-y-2\">\n                      <img src={selectedFileUrl} alt=\"Preview\" className=\"max-h-36 rounded-lg object-contain\" />\n                      <button\n                        type=\"button\"\n                        onClick={() => setSelectedFileUrl(null)}\n                        className=\"text-[10px] font-mono text-red-400 uppercase tracking-widest hover:underline cursor-pointer\"\n                      >\n                        Change Photo\n                      </button>\n                    </div>\n                  ) : (\n                    <div className=\"text-center space-y-2\">\n                      <div className=\"p-3 rounded-full bg-white/5 border border-white/10 text-white inline-block\">\n                        <Upload className=\"w-5 h-5\" />\n                      </div>\n                      <p className=\"text-xs font-semibold text-zinc-300\">Select or drag an image</p>\n                      <p className=\"text-[10px] text-zinc-500 font-mono\">Supports JPG, PNG up to 2MB</p>\n                      <input\n                        id=\"photo-file-upload-input\"\n                        type=\"file\"\n                        accept=\"image/*\"\n                        onChange={handleFileChange}\n                        className=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\"\n                        required\n                      />\n                    </div>\n                  )}\n                </div>\n\n              </div>\n\n              {submitError && (\n                <div className=\"flex items-center gap-2 text-[10px] text-red-400 font-mono uppercase tracking-wide\">\n                  <AlertCircle className=\"w-4 h-4\" />\n                  <span>{submitError}</span>\n                </div>\n              )}\n\n              <button\n                id=\"photo-submit-btn\"\n                type=\"submit\"\n                className={`w-full py-2.5 rounded-full text-[10px] font-bold uppercase tracking-widest transition cursor-pointer ${\n                  isTurtle\n                    ? \'bg-emerald-500 hover:bg-emerald-400 text-stone-950\'\n                    : \'bg-blue-500 hover:bg-blue-400 text-stone-950\'\n                }`}\n              >\n                Publish Photo\n              </button>\n            </form>\n          )}\n        </div>\n      )}\n\n      {/* Filter tabs */}\n      <div className=\"flex items-center gap-2 mb-8 overflow-x-auto pb-2 border-b border-white/5\" id=\"gallery-filters\">\n        <Filter className=\"w-3.5 h-3.5 text-zinc-500 shrink-0\" />\n        {[\n          { id: \'all\', label: \'All Moments\' },\n          { id: \'experiments\', label: \'Experiments\' },\n          { id: \'field-trips\', label: \'Field Trips\' },\n          { id: \'lab-meetings\', label: \'Lab Meetings\' }\n        ].map((f) => {\n          const isActive = activeFilter === f.id;\n          return (\n            <button\n              id={`gallery-filter-${f.id}`}\n              key={f.id}\n              onClick={() => setActiveFilter(f.id as any)}\n              className={`px-3 py-1.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-widest shrink-0 transition cursor-pointer ${\n                isActive\n                  ? \'bg-white/10 text-white border border-white/10\'\n                  : \'text-zinc-400 hover:text-white border border-transparent\'\n              }`}\n            >\n              {f.label}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Grid of Photo Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {filteredPhotos.map((photo) => (\n          <div\n            id={`gallery-card-${photo.id}`}\n            key={photo.id}\n            className=\"rounded-[2rem] overflow-hidden border border-white/10 bg-zinc-900/40 backdrop-blur-md transition-all duration-300 flex flex-col justify-between hover:border-white/20 shadow-xl\"\n          >\n            {/* Visual Header */}\n            <div className=\"relative h-56 overflow-hidden border-b border-white/5\">\n              <img\n                src={photo.imageUrl}\n                alt={photo.title}\n                className=\"w-full h-full object-cover transition-transform duration-500 hover:scale-[1.03]\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"absolute bottom-3 left-3 px-2.5 py-1 rounded-full text-[9px] font-mono font-bold uppercase tracking-widest shadow-md bg-zinc-950/80 text-white border border-white/10\">\n                {photo.category.replace(\'-\', \' \')}\n              </span>\n            </div>\n\n            {/* Description Body */}\n            <div className=\"p-5 space-y-3 flex-1 flex flex-col justify-between\">\n              <div className=\"space-y-1\">\n                <h4 className=\"font-display font-bold text-base leading-snug tracking-tight text-white\">\n                  {photo.title}\n                </h4>\n                <p className=\"text-xs leading-relaxed text-zinc-400\">\n                  {photo.description}\n                </p>\n              </div>\n\n              {/* Attribution */}\n              <div className=\"pt-3 border-t border-white/10 text-[9px] font-mono flex items-center justify-between text-zinc-400 uppercase tracking-wide\">\n                <span>By: {photo.submittedBy}</span>\n                <span>{photo.date}</span>\n              </div>\n            </div>\n\n          </div>\n        ))}\n      </div>\n\n      {filteredPhotos.length === 0 && (\n        <div className=\"text-center py-16 border border-dashed border-white/10 rounded-[2rem] bg-zinc-900/20\">\n          <ImageIcon className=\"w-10 h-10 text-zinc-600 mx-auto mb-2\" />\n          <p className=\"font-mono font-bold text-xs uppercase tracking-widest text-zinc-400\">No moments recorded</p>\n          <p className=\"text-xs text-zinc-500 mt-1\">Join the club, perform virtual experiments, and upload your first snapshot!</p>\n        </div>\n      )}\n\n    </section>\n  );"
      }
      num_matches: 1
    }
  }
