    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "        {/* Interactive Controls Panel (Right) */}\n        <div className={`lg:col-span-5 rounded-2xl p-6 border flex flex-col justify-between ${\n          isTurtle ? \'bg-white border-emerald-100\' : \'bg-slate-900 border-slate-800 text-slate-100\'\n        }`}>\n          <div>\n            <div className=\"flex items-center gap-2 mb-4\">\n              <FlaskConical className={`w-5 h-5 ${isTurtle ? \'text-emerald-600\' : \'text-indigo-400\'}`} />\n              <h4 className=\"font-display font-bold text-lg\">\n                {activeExp === \'lava\' && \'Lava Bubble Calibrator\'}\n                {activeExp === \'volcano\' && \'Eruption Reagent Proportions\'}\n                {activeExp === \'stargazing\' && \'Star Alignment Deck\'}\n              </h4>\n            </div>\n\n            {/* LAVA LAMP CONTROLS */}\n            {activeExp === \'lava\' && (\n              <div className=\"space-y-5\">\n                <p className={`text-xs leading-normal ${isTurtle ? \'text-stone-600\' : \'text-slate-300\'}`}>\n                  Lava lamps function by heating water and colorful wax. The wax expands, decreases in density, and floats. As it cools near the cap, it contracts, increases in density, and falls.\n                </p>\n\n                {/* Color presets */}\n                <div className=\"space-y-2\">\n                  <label className=\"text-xs font-semibold font-mono\">Select Thermal Pigment</label>\n                  <div className=\"flex gap-2\">\n                    {[\n                      { code: \'#ef4444\', label: \'Ruby\' },\n                      { code: \'#f59e0b\', label: \'Amber\' },\n                      { code: \'#10b981\', label: \'Teal\' },\n                      { code: \'#3b82f6\', label: \'Royal\' }\n                    ].map((c) => (\n                      <button\n                        key={c.code}\n                        onClick={() => setLavaColor(c.code)}\n                        className=\"flex-1 py-1.5 rounded-lg text-[10px] font-bold text-stone-900 border transition cursor-pointer\"\n                        style={{\n                          backgroundColor: c.code,\n                          borderColor: lavaColor === c.code ? \'#000000\' : \'transparent\',\n                          color: c.code === \'#ffffff\' ? \'#000\' : \'#fff\'\n                        }}\n                      >\n                        {c.label}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Density slider */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-xs font-mono\">\n                    <span>Specific Fluid Density</span>\n                    <span className=\"font-semibold\">{fluidDensity.toFixed(2)} g/cm\302\263</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0.3\"\n                    max=\"0.95\"\n                    step=\"0.05\"\n                    value={fluidDensity}\n                    onChange={(e) => setFluidDensity(parseFloat(e.target.value))}\n                    className=\"w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600\"\n                  />\n                  <div className=\"flex justify-between text-[9px] text-stone-400 font-mono\">\n                    <span>Loose Blobs (Fast)</span>\n                    <span>Sticky Conglomerate (Slow)</span>\n                  </div>\n                </div>\n\n                {/* Dropped Tablet stats */}\n                <div className={`p-3 rounded-xl border text-[11px] font-mono flex items-center justify-between ${\n                  isTurtle ? \'bg-emerald-50/50 border-emerald-100\' : \'bg-slate-950/60 border-slate-800\'\n                }`}>\n                  <span>Tablets Dropped:</span>\n                  <span className=\"font-bold text-yellow-500\">{tabletDropCount} / 3</span>\n                </div>\n              </div>\n            )}\n\n            {/* VOLCANO CHEMICAL CONTROLS */}\n            {activeExp === \'volcano\' && (\n              <div className=\"space-y-5\">\n                <p className={`text-xs leading-normal ${isTurtle ? \'text-stone-600\' : \'text-slate-300\'}`}>\n                  Acetic Acid (Vinegar) reacts dynamically with Sodium Bicarbonate (Baking Soda) to produce Carbon Dioxide (CO\342\202\202) gas, creating expanding bubbly froth!\n                </p>\n\n                {/* Sodium carbonate slider */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-xs font-mono\">\n                    <span>Sodium Bicarbonate (Base)</span>\n                    <span className=\"font-semibold\">{bakingSoda} grams</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"5\"\n                    max=\"30\"\n                    step=\"1\"\n                    value={bakingSoda}\n                    onChange={(e) => setBakingSoda(parseInt(e.target.value))}\n                    className=\"w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600\"\n                  />\n                  <div className=\"flex justify-between text-[9px] text-stone-400\">\n                    <span>5g (Light fizz)</span>\n                    <span>30g (Dense pile)</span>\n                  </div>\n                </div>\n\n                {/* Acetic Acid slider */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-xs font-mono\">\n                    <span>Acetic Acid (Vinegar)</span>\n                    <span className=\"font-semibold\">{vinegar} ml</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"20\"\n                    max=\"100\"\n                    step=\"5\"\n                    value={vinegar}\n                    onChange={(e) => setVinegar(parseInt(e.target.value))}\n                    className=\"w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600\"\n                  />\n                  <div className=\"flex justify-between text-[9px] text-stone-400\">\n                    <span>20ml (Minor trickle)</span>\n                    <span>100ml (High volume)</span>\n                  </div>\n                </div>\n\n                {/* Foam visual hue */}\n                <div className=\"space-y-2\">\n                  <label className=\"text-xs font-semibold font-mono\">Select Color Agent</label>\n                  <div className=\"flex gap-2\">\n                    {[\n                      { id: \'red\', label: \'Magma Red\', bg: \'#ef4444\' },\n                      { id: \'green\', label: \'Bio Green\', bg: \'#22c55e\' },\n                      { id: \'purple\', label: \'Neon Purple\', bg: \'#a855f7\' }\n                    ].map((item) => (\n                      <button\n                        key={item.id}\n                        onClick={() => setLavaTone(item.id as any)}\n                        className={`flex-1 py-1.5 rounded-lg text-[10px] font-bold text-stone-900 border transition-all cursor-pointer`}\n                        style={{\n                          backgroundColor: item.bg,\n                          borderColor: lavaTone === item.id ? \'#000\' : \'transparent\',\n                          color: \'#fff\'\n                        }}\n                      >\n                        {item.label}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {/* STARGAZING TELESCOPE CONTROLS */}\n            {activeExp === \'stargazing\' && (\n              <div className=\"space-y-5\">\n                <p className={`text-xs leading-normal ${isTurtle ? \'text-stone-600\' : \'text-slate-300\'}`}>\n                  Rotate the telescope tracking dials to shift Right Ascension degrees. Settle coordinates carefully to resolve Orion, Ursa Major, and Cassiopeia constellations.\n                </p>\n\n                {/* Rotation dial slider */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-xs font-mono\">\n                    <span>RA Coordinate Position</span>\n                    <span className=\"font-semibold\">{skyRotation}\302\260</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"360\"\n                    step=\"1\"\n                    value={skyRotation}\n                    onChange={(e) => setSkyRotation(parseInt(e.target.value))}\n                    className=\"w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600\"\n                  />\n                  <div className=\"flex justify-between text-[9px] text-stone-400 font-mono\">\n                    <span>0\302\260 North</span>\n                    <span>180\302\260 South</span>\n                    <span>360\302\260 North</span>\n                  </div>\n                </div>\n\n                <div className={`p-3.5 rounded-xl border text-xs leading-normal font-mono ${\n                  isTurtle ? \'bg-emerald-50/50 border-emerald-100\' : \'bg-slate-950/60 border-slate-800\'\n                }`}>\n                  <h5 className=\"font-semibold mb-1 text-yellow-500\">Alignment Milestones:</h5>\n                  <ul className=\"space-y-1 text-[11px] list-disc list-inside text-stone-500\">\n                    <li>Orion: Align around 60\302\260</li>\n                    <li>Ursa Major: Align around 180\302\260</li>\n                    <li>Cassiopeia: Align around 300\302\260</li>\n                  </ul>\n                </div>\n              </div>\n            )}\n\n          </div>\n\n          {/* Core Trigger CTA & Badge Tracker */}\n          <div className=\"pt-6 border-t border-slate-200/50 mt-6 space-y-4\">\n            {activeExp === \'lava\' && (\n              <button\n                id=\"drop-tablet-btn\"\n                onClick={handleDropTablet}\n                disabled={isLavaReacting}\n                className={`w-full py-3 rounded-xl font-bold text-sm shadow-md transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-2 ${\n                  isLavaReacting \n                    ? \'bg-slate-300 text-slate-500 cursor-not-allowed\'\n                    : isTurtle \n                      ? \'bg-emerald-600 hover:bg-emerald-500 text-white\' \n                      : \'bg-indigo-600 hover:bg-indigo-500 text-white\'\n                }`}\n              >\n                <Plus className=\"w-4 h-4\" />\n                <span>{isLavaReacting ? \'Dissolving Tablet...\' : \'Drop Effervescent Tablet\'}</span>\n              </button>\n            )}\n\n            {activeExp === \'volcano\' && (\n              <button\n                id=\"erupt-volcano-btn\"\n                onClick={handleErupt}\n                disabled={isErupting}\n                className={`w-full py-3 rounded-xl font-bold text-sm shadow-md transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-2 ${\n                  isErupting \n                    ? \'bg-slate-300 text-slate-500 cursor-not-allowed\'\n                    : isTurtle \n                      ? \'bg-amber-500 hover:bg-amber-400 text-stone-900 shadow-amber-500/10\' \n                      : \'bg-red-600 hover:bg-red-500 text-white\'\n                }`}\n              >\n                <Flame className=\"w-4 h-4 animate-bounce\" />\n                <span>{isErupting ? \'Erupting Lava Foam...\' : \'Trigger Eruption\'}</span>\n              </button>\n            )}\n\n            {/* Badges sidebar alert */}\n            <div className={`p-3.5 rounded-xl border flex items-center gap-3.5 ${\n              isTurtle ? \'bg-amber-50/50 border-amber-100\' : \'bg-slate-950 border-slate-800\'\n            }`}>\n              <div className=\"p-2 rounded-lg bg-yellow-500 text-stone-950\">\n                <Trophy className=\"w-5 h-5 animate-pulse\" />\n              </div>\n              <div className=\"text-left\">\n                <h5 className=\"font-bold text-xs\">Unlock scientist badges:</h5>\n                <p className=\"text-[10px] text-stone-400\">Complete tasks to earn XP and showcase achievements on your profile page!</p>\n              </div>\n            </div>\n          </div>\n\n        </div>"
      replacement_content: "        {/* Interactive Controls Panel (Right) */}\n        <div className=\"lg:col-span-5 rounded-[2rem] p-6 border border-white/10 bg-zinc-900/40 backdrop-blur-md flex flex-col justify-between text-white shadow-2xl\">\n          <div>\n            <div className=\"flex items-center gap-2 mb-4\">\n              <FlaskConical className=\"w-5 h-5 text-zinc-400\" />\n              <h4 className=\"font-display font-bold text-base tracking-tight text-white\">\n                {activeExp === \'lava\' && \'Lava Bubble Calibrator\'}\n                {activeExp === \'volcano\' && \'Eruption Reagent Proportions\'}\n                {activeExp === \'stargazing\' && \'Star Alignment Deck\'}\n              </h4>\n            </div>\n\n            {/* LAVA LAMP CONTROLS */}\n            {activeExp === \'lava\' && (\n              <div className=\"space-y-5\">\n                <p className=\"text-xs leading-normal text-zinc-400 font-sans\">\n                  Lava lamps function by heating water and colorful wax. The wax expands, decreases in density, and floats. As it cools near the cap, it contracts, increases in density, and falls.\n                </p>\n\n                {/* Color presets */}\n                <div className=\"space-y-2\">\n                  <label className=\"text-[10px] font-bold font-mono uppercase tracking-widest text-zinc-500\">Select Thermal Pigment</label>\n                  <div className=\"flex gap-2\">\n                    {[\n                      { code: \'#ef4444\', label: \'Ruby\' },\n                      { code: \'#f59e0b\', label: \'Amber\' },\n                      { code: \'#10b981\', label: \'Teal\' },\n                      { code: \'#3b82f6\', label: \'Royal\' }\n                    ].map((c) => (\n                      <button\n                        key={c.code}\n                        onClick={() => setLavaColor(c.code)}\n                        className={`flex-1 py-1.5 rounded-lg text-[10px] font-bold border transition cursor-pointer ${\n                          lavaColor === c.code ? \'border-white scale-105\' : \'border-white/10\'\n                        }`}\n                        style={{\n                          backgroundColor: c.code,\n                          color: \'#fff\',\n                          textShadow: \'0 1px 2px rgba(0,0,0,0.5)\'\n                        }}\n                      >\n                        {c.label}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Density slider */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-[11px] font-mono text-zinc-300\">\n                    <span>Specific Fluid Density</span>\n                    <span className=\"font-bold\">{fluidDensity.toFixed(2)} g/cm\302\263</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0.3\"\n                    max=\"0.95\"\n                    step=\"0.05\"\n                    value={fluidDensity}\n                    onChange={(e) => setFluidDensity(parseFloat(e.target.value))}\n                    className=\"w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-white\"\n                  />\n                  <div className=\"flex justify-between text-[9px] text-zinc-500 font-mono\">\n                    <span>Loose Blobs (Fast)</span>\n                    <span>Sticky Conglomerate (Slow)</span>\n                  </div>\n                </div>\n\n                {/* Dropped Tablet stats */}\n                <div className=\"p-3.5 rounded-2xl border border-white/10 bg-white/5 text-[11px] font-mono flex items-center justify-between text-zinc-300\">\n                  <span>Tablets Dropped:</span>\n                  <span className=\"font-bold text-yellow-500\">{tabletDropCount} / 3</span>\n                </div>\n              </div>\n            )}\n\n            {/* VOLCANO CHEMICAL CONTROLS */}\n            {activeExp === \'volcano\' && (\n              <div className=\"space-y-5\">\n                <p className=\"text-xs leading-normal text-zinc-400 font-sans\">\n                  Acetic Acid (Vinegar) reacts dynamically with Sodium Bicarbonate (Baking Soda) to produce Carbon Dioxide (CO\342\202\202) gas, creating expanding bubbly froth!\n                </p>\n\n                {/* Sodium carbonate slider */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-[11px] font-mono text-zinc-300\">\n                    <span>Sodium Bicarbonate (Base)</span>\n                    <span className=\"font-bold\">{bakingSoda} grams</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"5\"\n                    max=\"30\"\n                    step=\"1\"\n                    value={bakingSoda}\n                    onChange={(e) => setBakingSoda(parseInt(e.target.value))}\n                    className=\"w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-white\"\n                  />\n                  <div className=\"flex justify-between text-[9px] text-zinc-500 font-mono\">\n                    <span>5g (Light fizz)</span>\n                    <span>30g (Dense pile)</span>\n                  </div>\n                </div>\n\n                {/* Acetic Acid slider */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-[11px] font-mono text-zinc-300\">\n                    <span>Acetic Acid (Vinegar)</span>\n                    <span className=\"font-bold\">{vinegar} ml</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"20\"\n                    max=\"100\"\n                    step=\"5\"\n                    value={vinegar}\n                    onChange={(e) => setVinegar(parseInt(e.target.value))}\n                    className=\"w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-white\"\n                  />\n                  <div className=\"flex justify-between text-[9px] text-zinc-500 font-mono\">\n                    <span>20ml (Minor trickle)</span>\n                    <span>100ml (High volume)</span>\n                  </div>\n                </div>\n\n                {/* Foam visual hue */}\n                <div className=\"space-y-2\">\n                  <label className=\"text-[10px] font-bold font-mono uppercase tracking-widest text-zinc-500\">Select Color Agent</label>\n                  <div className=\"flex gap-2\">\n                    {[\n                      { id: \'red\', label: \'Magma Red\', bg: \'#ef4444\' },\n                      { id: \'green\', label: \'Bio Green\', bg: \'#22c55e\' },\n                      { id: \'purple\', label: \'Neon Purple\', bg: \'#a855f7\' }\n                    ].map((item) => (\n                      <button\n                        key={item.id}\n                        onClick={() => setLavaTone(item.id as any)}\n                        className={`flex-1 py-1.5 rounded-lg text-[10px] font-bold border transition-all cursor-pointer ${\n                          lavaTone === item.id ? \'border-white scale-105\' : \'border-white/10\'\n                        }`}\n                        style={{\n                          backgroundColor: item.bg,\n                          color: \'#fff\',\n                          textShadow: \'0 1px 2px rgba(0,0,0,0.5)\'\n                        }}\n                      >\n                        {item.label}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {/* STARGAZING TELESCOPE CONTROLS */}\n            {activeExp === \'stargazing\' && (\n              <div className=\"space-y-5\">\n                <p className=\"text-xs leading-normal text-zinc-400 font-sans\">\n                  Rotate the telescope tracking dials to shift Right Ascension degrees. Settle coordinates carefully to resolve Orion, Ursa Major, and Cassiopeia constellations.\n                </p>\n\n                {/* Rotation dial slider */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between text-[11px] font-mono text-zinc-300\">\n                    <span>RA Coordinate Position</span>\n                    <span className=\"font-bold\">{skyRotation}\302\260</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"360\"\n                    step=\"1\"\n                    value={skyRotation}\n                    onChange={(e) => setSkyRotation(parseInt(e.target.value))}\n                    className=\"w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-white\"\n                  />\n                  <div className=\"flex justify-between text-[9px] text-zinc-500 font-mono\">\n                    <span>0\302\260 North</span>\n                    <span>180\302\260 South</span>\n                    <span>360\302\260 North</span>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl border border-white/10 bg-white/5 text-xs leading-normal font-mono text-zinc-300\">\n                  <h5 className=\"font-bold mb-1 text-yellow-500\">Alignment Milestones:</h5>\n                  <ul className=\"space-y-1 text-[11px] list-disc list-inside text-zinc-400\">\n                    <li>Orion: Align around 60\302\260</li>\n                    <li>Ursa Major: Align around 180\302\260</li>\n                    <li>Cassiopeia: Align around 300\302\260</li>\n                  </ul>\n                </div>\n              </div>\n            )}\n\n          </div>\n\n          {/* Core Trigger CTA & Badge Tracker */}\n          <div className=\"pt-6 border-t border-white/10 mt-6 space-y-4\">\n            {activeExp === \'lava\' && (\n              <button\n                id=\"drop-tablet-btn\"\n                onClick={handleDropTablet}\n                disabled={isLavaReacting}\n                className={`w-full py-2.5 px-4 rounded-full font-mono font-bold text-[10px] uppercase tracking-widest shadow-lg transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-2 ${\n                  isLavaReacting \n                    ? \'bg-zinc-800 text-zinc-500 border border-white/5 cursor-not-allowed\'\n                    : isTurtle \n                      ? \'bg-emerald-500 hover:bg-emerald-400 text-stone-950 shadow-emerald-500/10\' \n                      : \'bg-blue-500 hover:bg-blue-400 text-stone-950 shadow-blue-500/10\'\n                }`}\n              >\n                <Plus className=\"w-4 h-4\" />\n                <span>{isLavaReacting ? \'Dissolving Tablet...\' : \'Drop Effervescent Tablet\'}</span>\n              </button>\n            )}\n\n            {activeExp === \'volcano\' && (\n              <button\n                id=\"erupt-volcano-btn\"\n                onClick={handleErupt}\n                disabled={isErupting}\n                className={`w-full py-2.5 px-4 rounded-full font-mono font-bold text-[10px] uppercase tracking-widest shadow-lg transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-2 ${\n                  isErupting \n                    ? \'bg-zinc-800 text-zinc-500 border border-white/5 cursor-not-allowed\'\n                    : isTurtle \n                      ? \'bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-amber-500/10\' \n                      : \'bg-red-500 hover:bg-red-400 text-stone-950 shadow-red-500/10\'\n                }`}\n              >\n                <Flame className=\"w-4 h-4 animate-bounce\" />\n                <span>{isErupting ? \'Erupting Lava Foam...\' : \'Trigger Eruption\'}</span>\n              </button>\n            )}\n\n            {/* Badges sidebar alert */}\n            <div className=\"p-4 rounded-2xl border border-white/10 bg-white/5 flex items-center gap-3.5 text-zinc-300\">\n              <div className=\"p-2 rounded-xl bg-yellow-500/15 border border-yellow-500/30 text-yellow-400\">\n                <Trophy className=\"w-5 h-5 animate-pulse\" />\n              </div>\n              <div className=\"text-left\">\n                <h5 className=\"font-mono font-bold text-[10px] uppercase tracking-wider text-white\">Unlock scientist badges</h5>\n                <p className=\"text-[10px] text-zinc-400 font-sans mt-0.5 leading-relaxed\">Complete tasks to earn XP and showcase achievements on your profile page!</p>\n              </div>\n            </div>\n          </div>\n\n        </div>"
