    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ClubIdentity, Mission, UserProfile } from \'../types\';\nimport { Calendar, Clock, MapPin, Users, CheckCircle, Ticket, LogIn } from \'lucide-react\';\n\ninterface UpcomingMissionsProps {\n  identity: ClubIdentity;\n  missions: Mission[];\n  userProfile: UserProfile;\n  onReserve: (missionId: string) => void;\n  onCancelReserve: (missionId: string) => void;\n  onOpenJoin: () => void;\n}\n\nexport default function UpcomingMissions({\n  identity,\n  missions,\n  userProfile,\n  onReserve,\n  onCancelReserve,\n  onOpenJoin\n}: UpcomingMissionsProps) {\n  const isTurtle = identity === \'turtlerock\';\n\n  const isJoined = userProfile.level > 0;\n\n  return (\n    <section className=\"py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto\">\n      <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4\">\n        <div>\n          <h3 className={`font-display font-bold text-2xl sm:text-3xl tracking-tight ${\n            isTurtle ? \'text-emerald-900\' : \'text-slate-100\'\n          }`}>\n            Upcoming Missions & Bench Events\n          </h3>\n          <p className={`text-sm mt-1.5 ${isTurtle ? \'text-stone-600\' : \'text-slate-400\'}`}>\n            {isTurtle \n              ? \'Join our local collaborative social workshops. Reserve early as equipment sets are limited!\'\n              : \'Secure a physical station for our structured experimental design blocks.\'}\n          </p>\n        </div>\n\n        {/* Quick status badge */}\n        {isJoined && (\n          <div className={`text-xs px-3 py-1.5 rounded-lg border font-mono font-medium flex items-center gap-1.5 ${\n            isTurtle \n              ? \'bg-emerald-50 border-emerald-200 text-emerald-800\' \n              : \'bg-slate-900 border-slate-800 text-indigo-300\'\n          }`}>\n            <Ticket className=\"w-3.5 h-3.5 text-amber-500\" />\n            <span>Reserved {userProfile.reservedMissionIds.length} of {missions.length} events</span>\n          </div>\n        )}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {missions.map((mission) => {\n          const isReserved = userProfile.reservedMissionIds.includes(mission.id);\n          const spotsLeft = mission.spotsTotal - mission.spotsReserved;\n          const isSoldOut = spotsLeft <= 0;\n\n          return (\n            <div \n              id={`mission-card-${mission.id}`}\n              key={mission.id} \n              className={`rounded-2xl overflow-hidden border transition-all duration-300 flex flex-col justify-between ${\n                isTurtle \n                  ? \'bg-white border-emerald-100 shadow-sm hover:shadow-md\' \n                  : \'bg-slate-900 border-slate-800/80 shadow-md text-slate-100\'\n              }`}\n            >\n              {/* Image Section with overlays */}\n              <div className=\"relative h-48 overflow-hidden\">\n                <img \n                  src={mission.image} \n                  alt={mission.title} \n                  className=\"w-full h-full object-cover transition-transform duration-500 hover:scale-105\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                \n                {/* Spot left counts overlay */}\n                <div className=\"absolute top-3 left-3 flex gap-1.5\">\n                  <span className={`px-2.5 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase shadow-xs ${\n                    isSoldOut \n                      ? \'bg-red-500 text-white\' \n                      : spotsLeft < 5 \n                        ? \'bg-amber-500 text-stone-900\'\n                        : isTurtle \n                          ? \'bg-emerald-600 text-white\' \n                          : \'bg-indigo-600 text-white\'\n                  }`}>\n                    {isSoldOut ? \'Sold Out\' : `${spotsLeft} benches left`}\n                  </span>\n                </div>\n              </div>\n\n              {/* Body Section */}\n              <div className=\"p-5 flex-1 flex flex-col justify-between space-y-4\">\n                <div className=\"space-y-2\">\n                  <h4 className=\"font-display font-bold text-lg leading-snug tracking-tight\">\n                    {mission.title}\n                  </h4>\n                  <p className={`text-xs leading-relaxed ${\n                    isTurtle ? \'text-stone-600\' : \'text-slate-300\'\n                  }`}>\n                    {mission.description}\n                  </p>\n                </div>\n\n                {/* Logistics */}\n                <div className={`space-y-2 pt-3 border-t text-[11px] font-mono ${\n                  isTurtle ? \'border-emerald-100/60 text-emerald-800\' : \'border-slate-800 text-slate-300\'\n                }`}>\n                  <div className=\"flex items-center gap-2\">\n                    <Calendar className=\"w-3.5 h-3.5 text-stone-400 shrink-0\" />\n                    <span>{mission.date}</span>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <Clock className=\"w-3.5 h-3.5 text-stone-400 shrink-0\" />\n                    <span>{mission.time}</span>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <MapPin className=\"w-3.5 h-3.5 text-stone-400 shrink-0\" />\n                    <span className=\"truncate\">{mission.location}</span>\n                  </div>\n                </div>\n\n                {/* RSVP Controls */}\n                <div className=\"pt-2\">\n                  {!isJoined ? (\n                    <button\n                      id={`mission-join-btn-${mission.id}`}\n                      onClick={onOpenJoin}\n                      className={`w-full py-2.5 px-4 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 shadow-sm transition-all hover:scale-[1.01] active:scale-95 cursor-pointer ${\n                        isTurtle\n                          ? \'bg-emerald-100 hover:bg-emerald-200 text-emerald-900\'\n                          : \'bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700\'\n                      }`}\n                    >\n                      <LogIn className=\"w-4 h-4 text-amber-500\" />\n                      <span>Join club to Reserve Spot</span>\n                    </button>\n                  ) : isReserved ? (\n                    <div className=\"space-y-2\">\n                      <div className={`flex items-center justify-center gap-1.5 py-1 text-xs font-mono font-semibold ${\n                        isTurtle ? \'text-emerald-700\' : \'text-indigo-400\'\n                      }`}>\n                        <CheckCircle className=\"w-4 h-4 text-emerald-500 fill-emerald-100\" />\n                        <span>Registered Scientist \342\234\224</span>\n                      </div>\n                      <button\n                        id={`mission-cancel-btn-${mission.id}`}\n                        onClick={() => onCancelReserve(mission.id)}\n                        className=\"w-full py-2 text-center text-[11px] font-mono text-red-500 hover:text-red-400 hover:underline cursor-pointer\"\n                      >\n                        Cancel Reservation\n                      </button>\n                    </div>\n                  ) : (\n                    <button\n                      id={`mission-reserve-btn-${mission.id}`}\n                      onClick={() => onReserve(mission.id)}\n                      disabled={isSoldOut}\n                      className={`w-full py-2.5 px-4 rounded-xl text-xs font-bold shadow-xs transition-all duration-200 active:scale-95 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed ${\n                        isTurtle\n                          ? \'bg-amber-500 text-stone-900 hover:bg-amber-400\'\n                          : \'bg-indigo-600 text-white hover:bg-indigo-500\'\n                      }`}\n                    >\n                      {isSoldOut ? \'No Stations Remaining\' : isTurtle ? \'Join This Mission\' : \'Reserve Bench\'}\n                    </button>\n                  )}\n                </div>\n\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </section>\n  );\n}\n"
    }
