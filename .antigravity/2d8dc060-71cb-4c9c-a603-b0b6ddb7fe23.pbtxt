    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\n\ninterface LogoProps {\n  className?: string;\n  size?: number;\n}\n\nexport default function TurtleRockLogo({ className = \'\', size = 120 }: LogoProps) {\n  return (\n    <svg\n      width={size}\n      height={size}\n      viewBox=\"0 0 240 240\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      className={`select-none ${className}`}\n      id=\"turtle-rock-svg-logo\"\n    >\n      <defs>\n        {/* Gradients */}\n        <linearGradient id=\"beakerFluid\" x1=\"120\" y1=\"75\" x2=\"120\" y2=\"135\" gradientUnits=\"userSpaceOnUse\">\n          <stop offset=\"0%\" stopColor=\"#4ade80\" />\n          <stop offset=\"60%\" stopColor=\"#22c55e\" />\n          <stop offset=\"100%\" stopColor=\"#15803d\" />\n        </linearGradient>\n\n        <linearGradient id=\"beakerDome\" x1=\"120\" y1=\"65\" x2=\"120\" y2=\"135\" gradientUnits=\"userSpaceOnUse\">\n          <stop offset=\"0%\" stopColor=\"#ffffff\" stopOpacity=\"0.4\" />\n          <stop offset=\"40%\" stopColor=\"#ffffff\" stopOpacity=\"0.1\" />\n          <stop offset=\"100%\" stopColor=\"#38bdf8\" stopOpacity=\"0.2\" />\n        </linearGradient>\n\n        <linearGradient id=\"turtleGrad\" x1=\"60\" y1=\"110\" x2=\"160\" y2=\"150\" gradientUnits=\"userSpaceOnUse\">\n          <stop offset=\"0%\" stopColor=\"#0d9488\" />\n          <stop offset=\"50%\" stopColor=\"#0f766e\" />\n          <stop offset=\"100%\" stopColor=\"#115e59\" />\n        </linearGradient>\n\n        <linearGradient id=\"glowingNode\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n          <stop offset=\"0%\" stopColor=\"#a7f3d0\" />\n          <stop offset=\"40%\" stopColor=\"#4ade80\" />\n          <stop offset=\"100%\" stopColor=\"#22c55e\" />\n        </linearGradient>\n\n        <filter id=\"glowEffect\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n          <feGaussianBlur stdDeviation=\"3\" result=\"blur\" />\n          <feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\" />\n        </filter>\n\n        {/* Text Curves */}\n        {/* Top Curve for \"TURTLE ROCK\" */}\n        <path\n          id=\"textCurveTop\"\n          d=\"M 35 110 A 85 85 0 0 1 205 110\"\n          fill=\"none\"\n        />\n\n        {/* Bottom Curve for \"science club\" (Right-to-Left so it remains upright) */}\n        <path\n          id=\"textCurveBottom\"\n          d=\"M 210 130 A 90 90 0 0 1 30 130\"\n          fill=\"none\"\n        />\n      </defs>\n\n      {/* --- LAYER 1: Atomic Orbits (Background) --- */}\n      <g strokeWidth=\"3\" stroke=\"#cbd5e1\" opacity=\"0.85\">\n        {/* Orbit rotated 0 */}\n        <g transform=\"rotate(0 120 120)\">\n          <ellipse cx=\"120\" cy=\"120\" rx=\"28\" ry=\"92\" stroke=\"#e2e8f0\" strokeWidth=\"3\" fill=\"none\" />\n          <circle cx=\"120\" cy=\"28\" r=\"8\" fill=\"url(#glowingNode)\" stroke=\"#111827\" strokeWidth=\"2.5\" filter=\"url(#glowEffect)\" />\n          <circle cx=\"120\" cy=\"212\" r=\"8\" fill=\"url(#glowingNode)\" stroke=\"#111827\" strokeWidth=\"2.5\" filter=\"url(#glowEffect)\" />\n        </g>\n        \n        {/* Orbit rotated 60 */}\n        <g transform=\"rotate(60 120 120)\">\n          <ellipse cx=\"120\" cy=\"120\" rx=\"28\" ry=\"92\" stroke=\"#e2e8f0\" strokeWidth=\"3\" fill=\"none\" />\n          <circle cx=\"120\" cy=\"28\" r=\"8\" fill=\"url(#glowingNode)\" stroke=\"#111827\" strokeWidth=\"2.5\" filter=\"url(#glowEffect)\" />\n          <circle cx=\"120\" cy=\"212\" r=\"8\" fill=\"url(#glowingNode)\" stroke=\"#111827\" strokeWidth=\"2.5\" filter=\"url(#glowEffect)\" />\n        </g>\n\n        {/* Orbit rotated 120 */}\n        <g transform=\"rotate(120 120 120)\">\n          <ellipse cx=\"120\" cy=\"120\" rx=\"28\" ry=\"92\" stroke=\"#e2e8f0\" strokeWidth=\"3\" fill=\"none\" />\n          <circle cx=\"120\" cy=\"28\" r=\"8\" fill=\"url(#glowingNode)\" stroke=\"#111827\" strokeWidth=\"2.5\" filter=\"url(#glowEffect)\" />\n          <circle cx=\"120\" cy=\"212\" r=\"8\" fill=\"url(#glowingNode)\" stroke=\"#111827\" strokeWidth=\"2.5\" filter=\"url(#glowEffect)\" />\n        </g>\n      </g>\n\n      {/* --- LAYER 2: The Turtle (Midground) --- */}\n      <g id=\"turtle-body\" stroke=\"#0f172a\" strokeWidth=\"3\" strokeLinejoin=\"round\">\n        {/* Tail */}\n        <path d=\"M 165 130 L 180 132 L 168 140 Z\" fill=\"url(#turtleGrad)\" />\n\n        {/* Back Flippers */}\n        <path d=\"M 145 138 C 158 148 165 160 152 165 C 138 170 135 152 145 138 Z\" fill=\"url(#turtleGrad)\" />\n\n        {/* Front Flippers */}\n        <path d=\"M 75 135 C 55 145 58 170 75 162 C 85 155 85 142 75 135 Z\" fill=\"url(#turtleGrad)\" />\n\n        {/* Head */}\n        <path d=\"M 72 125 C 52 124 45 106 58 98 C 72 90 85 108 78 120 Z\" fill=\"url(#turtleGrad)\" />\n        {/* Eye */}\n        <circle cx=\"60\" cy=\"106\" r=\"2.5\" fill=\"#ffffff\" stroke=\"none\" />\n        <circle cx=\"59.5\" cy=\"106.5\" r=\"1.2\" fill=\"#000000\" stroke=\"none\" />\n\n        {/* Turtle Main Body Underlay */}\n        <path d=\"M 70 128 C 95 142 145 142 168 128 C 168 128 145 148 70 128 Z\" fill=\"url(#turtleGrad)\" />\n      </g>\n\n      {/* --- LAYER 3: Beaker Dome Shell (Foreground) --- */}\n      <g id=\"beaker-dome-shell\">\n        {/* Liquid Base Fill */}\n        <path \n          d=\"M 80 128 A 45 45 0 0 1 160 128 Z\" \n          fill=\"url(#beakerFluid)\" \n          stroke=\"#0f172a\" \n          strokeWidth=\"3.5\" \n          strokeLinejoin=\"round\" \n        />\n\n        {/* Bubbles in liquid */}\n        <circle cx=\"98\" cy=\"112\" r=\"5\" fill=\"#a7f3d0\" opacity=\"0.8\" />\n        <circle cx=\"112\" cy=\"100\" r=\"3.5\" fill=\"#a7f3d0\" opacity=\"0.8\" />\n        <circle cx=\"132\" cy=\"115\" r=\"4.5\" fill=\"#a7f3d0\" opacity=\"0.8\" />\n        <circle cx=\"142\" cy=\"105\" r=\"3\" fill=\"#a7f3d0\" opacity=\"0.8\" />\n\n        {/* Liquid Surface Wave (darker green shading for wave visual) */}\n        <path \n          d=\"M 81 118 Q 100 110 120 120 T 159 116 L 159 128 L 81 128 Z\" \n          fill=\"#166534\" \n          opacity=\"0.25\" \n        />\n\n        {/* Glass Dome Overlay & Reflections */}\n        <path \n          d=\"M 79 128 A 46 46 0 0 1 161 128 Z\" \n          fill=\"url(#beakerDome)\" \n          stroke=\"#0f172a\" \n          strokeWidth=\"3.5\" \n          strokeLinejoin=\"round\" \n          opacity=\"0.95\"\n        />\n\n        {/* Glass Reflection Highlight Curve */}\n        <path \n          d=\"M 90 102 A 36 36 0 0 1 140 96\" \n          stroke=\"#ffffff\" \n          strokeWidth=\"3.5\" \n          strokeLinecap=\"round\" \n          opacity=\"0.5\" \n        />\n      </g>\n\n      {/* --- LAYER 4: Curved Typographic Texts --- */}\n      {/* Top curved text \"TURTLE ROCK\" */}\n      <text fontStyle=\"normal\" id=\"turtle-rock-text-path\">\n        <textPath \n          href=\"#textCurveTop\" \n          startOffset=\"50%\" \n          textAnchor=\"middle\" \n          className=\"font-black tracking-[0.14em]\" \n          style={{\n            fontSize: \'22px\', \n            fontWeight: 900, \n            fontFamily: \'\"Space Grotesk\", \"Inter\", sans-serif\',\n            fill: \'#0f172a\',\n            stroke: \'#ffffff\',\n            strokeWidth: \'4px\',\n            paintOrder: \'stroke fill\',\n            textTransform: \'uppercase\'\n          }}\n        >\n          TURTLE ROCK\n        </textPath>\n        \n        {/* Overlay standard text for solid crisp lettering */}\n        <textPath \n          href=\"#textCurveTop\" \n          startOffset=\"50%\" \n          textAnchor=\"middle\" \n          className=\"font-black tracking-[0.14em]\" \n          style={{\n            fontSize: \'22px\', \n            fontWeight: 900, \n            fontFamily: \'\"Space Grotesk\", \"Inter\", sans-serif\',\n            fill: \'#0284c7\', // vibrant blue-teal like the light blue highlight\n            paintOrder: \'fill\'\n          }}\n        >\n          TURTLE ROCK\n        </textPath>\n      </text>\n\n      {/* Bottom curved text \"science club\" */}\n      <text fontStyle=\"normal\" id=\"science-club-text-path\">\n        <textPath \n          href=\"#textCurveBottom\" \n          startOffset=\"50%\" \n          textAnchor=\"middle\" \n          className=\"tracking-[0.12em]\" \n          style={{\n            fontSize: \'17px\', \n            fontWeight: 800, \n            fontFamily: \'\"JetBrains Mono\", \"Inter\", monospace\',\n            fill: \'#0f172a\',\n            stroke: \'#ffffff\',\n            strokeWidth: \'3.5px\',\n            paintOrder: \'stroke fill\',\n          }}\n        >\n          science club\n        </textPath>\n\n        <textPath \n          href=\"#textCurveBottom\" \n          startOffset=\"50%\" \n          textAnchor=\"middle\" \n          className=\"tracking-[0.12em]\" \n          style={{\n            fontSize: \'17px\', \n            fontWeight: 800, \n            fontFamily: \'\"JetBrains Mono\", \"Inter\", monospace\',\n            fill: \'#10b981\', // emerald green to match science club green\n            paintOrder: \'fill\',\n          }}\n        >\n          science club\n        </textPath>\n      </text>\n    </svg>\n  );\n}\n"
    }
