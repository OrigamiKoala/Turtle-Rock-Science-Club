    instruction: "Update footer style to match the bento theme."
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <footer className={`transition-all duration-300 border-t ${\n      isTurtle \n        ? \'bg-emerald-950 text-emerald-100 border-emerald-900\' \n        : \'bg-stone-950 text-stone-200 border-stone-900\'\n    }`}>\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8\">\n          \n          {/* Brand Pillar */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-2\">\n              <div className={`p-1.5 rounded-lg ${isTurtle ? \'bg-emerald-800 text-emerald-300\' : \'bg-indigo-950 text-indigo-400\'}`}>\n                {isTurtle ? <span className=\"text-lg\">\360\237\220\242</span> : <Atom className=\"w-5 h-5\" />}\n              </div>\n              <span className=\"font-display font-bold text-lg tracking-tight\">\n                {isTurtle ? \'Turtle Rock Science Club\' : \'Kinetic Lab\'}\n              </span>\n            </div>\n            <p className=\"text-xs text-opacity-85 text-emerald-200/80 leading-relaxed font-sans\">\n              {isTurtle \n                ? \'Nurturing the next generation of naturalists and innovators through community-centered, hands-on scientific adventure.\'\n                : \'Accelerating rigorous scientific inquiry and methodology through structured experimentation and engineering design.\'}\n            </p>\n            <div className={`inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-mono font-medium ${\n              isTurtle ? \'bg-emerald-900 text-emerald-300\' : \'bg-stone-900 text-indigo-400\'\n            }`}>\n              <ShieldAlert className=\"w-3.5 h-3.5\" />\n              Safety-Certified Instructors\n            </div>\n          </div>\n\n          {/* Site Navigation Links */}\n          <div>\n            <h4 className=\"font-display font-semibold text-sm uppercase tracking-wider mb-4 text-white\">Explore Labs</h4>\n            <ul className=\"space-y-2 text-xs font-medium\">\n              <li>\n                <button onClick={() => setCurrentTab(\'missions\')} className=\"hover:text-amber-400 transition cursor-pointer\">\n                  Missions & Events\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setCurrentTab(\'lab\')} className=\"hover:text-amber-400 transition cursor-pointer\">\n                  Virtual Lab & Simulators\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setCurrentTab(\'logs\')} className=\"hover:text-amber-400 transition cursor-pointer\">\n                  Lab Logs & Announcements\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setCurrentTab(\'gallery\')} className=\"hover:text-amber-400 transition cursor-pointer\">\n                  Community Gallery\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Standard FAQ / Core Principles */}\n          <div>\n            <h4 className=\"font-display font-semibold text-sm uppercase tracking-wider mb-4 text-white\">Foundations</h4>\n            <ul className=\"space-y-2 text-xs font-medium\">\n              <li>\n                <button onClick={() => setCurrentTab(\'about\')} className=\"hover:text-amber-400 transition cursor-pointer\">\n                  About Our Founders\n                </button>\n              </li>\n              <li>\n                <button onClick={() => setCurrentTab(\'about\')} className=\"hover:text-amber-400 transition cursor-pointer flex items-center gap-1\">\n                  <HelpCircle className=\"w-3.5 h-3.5 text-stone-400\" />\n                  Frequently Asked Questions\n                </button>\n              </li>\n              <li className=\"text-emerald-300/70 text-[11px] leading-relaxed mt-3\">\n                {isTurtle\n                  ? \'Meeting weekly at Turtle Rock Clubhouse Basecamp and Valley Park.\'\n                  : \'Operating at Kinetic HQ Benchrooms A-D, Suite 402.\'}\n              </li>\n            </ul>\n          </div>\n\n          {/* Quick Support Badge */}\n          <div className=\"space-y-4\">\n            <h4 className=\"font-display font-semibold text-sm uppercase tracking-wider text-white\">Contact & Support</h4>\n            <p className=\"text-xs text-opacity-80 text-emerald-200/70 leading-relaxed\">\n              Have questions, materials to donate, or want to collaborate? Get in touch!\n            </p>\n            <div className=\"space-y-1.5 text-xs font-mono\">\n              <p className=\"flex items-center gap-1.5\">\n                <Mail className=\"w-3.5 h-3.5 text-amber-400\" />\n                hello@{isTurtle ? \'turtlerockscience.org\' : \'kineticlab.dev\'}\n              </p>\n              <p className=\"opacity-60 text-[10px]\">Response time: Under 24 hours</p>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Bottom Rights Bar */}\n        <div className={`mt-12 pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-opacity-70 ${\n          isTurtle ? \'border-emerald-900/60 text-emerald-300/80\' : \'border-stone-900 text-stone-400\'\n        }`}>\n          <p>\302\251 2026 {isTurtle ? \'Turtle Rock Science Club\' : \'Kinetic Lab Inc\'}. All rights reserved.</p>\n          <div className=\"flex items-center gap-1 text-[11px]\">\n            <span>Crafted with</span>\n            <Heart className=\"w-3 h-3 text-red-500 fill-red-500 animate-pulse\" />\n            <span>for community discoveries.</span>\n          </div>\n        </div>\n\n      </div>\n    </footer>"
        replacement_content: "  return (\n    <footer className=\"transition-all duration-300 border-t border-white/10 bg-[#070708] text-zinc-300 relative z-10\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8\">\n          \n          {/* Brand Pillar */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"p-1.5 rounded-lg bg-white/5 border border-white/10 text-white\">\n                {isTurtle ? <span className=\"text-lg\">\360\237\220\242</span> : <Atom className=\"w-4 h-4 text-blue-400\" />}\n              </div>\n              <span className=\"font-display font-bold text-base tracking-tight text-white\">\n                {isTurtle ? \'Turtle Rock Science Club\' : \'Kinetic Lab\'}\n              </span>\n            </div>\n            <p className=\"text-xs text-zinc-400 leading-relaxed font-sans\">\n              {isTurtle \n                ? \'Nurturing the next generation of naturalists and innovators through community-centered, hands-on scientific adventure.\'\n                : \'Accelerating rigorous scientific inquiry and methodology through structured experimentation and engineering design.\'}\n            </p>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-widest bg-white/5 border border-white/10 text-zinc-300\">\n              <ShieldAlert className=\"w-3.5 h-3.5 text-amber-500\" />\n              Safety-Certified Instructors\n            </div>\n          </div>\n\n          {/* Site Navigation Links */}\n          <div>\n            <h4 className=\"font-mono font-bold text-xs uppercase tracking-widest mb-4 text-zinc-500\">Explore Labs</h4>\n            <ul className=\"space-y-2 text-xs font-sans\">\n              <li>\n                <button onClick={() => setCurrentTab(\'missions\')} className=