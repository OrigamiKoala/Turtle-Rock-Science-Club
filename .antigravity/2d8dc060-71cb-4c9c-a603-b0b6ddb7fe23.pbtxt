ly: \'\"Space Grotesk\", \"Inter\", sans-serif\',\n                fill: \'#0284c7\', // vibrant blue-teal like the light blue highlight\n                paintOrder: \'fill\'\n              }}\n            >\n              TURTLE ROCK\n            </textPath>\n          </text>\n\n          {/* Bottom curved text \"science club\" */}\n          <text fontStyle=\"normal\" id=\"science-club-text-path\">\n            <textPath \n              href=\"#textCurveBottom\" \n              startOffset=\"50%\" \n              textAnchor=\"middle\" \n              className=\"tracking-[0.12em]\" \n              style={{\n                fontSize: \'17px\', \n                fontWeight: 800, \n                fontFamily: \'\"JetBrains Mono\", \"Inter\", monospace\',\n                fill: \'#0f172a\',\n                stroke: \'#ffffff\',\n                strokeWidth: \'3.5px\',\n                paintOrder: \'stroke fill\',\n              }}\n            >\n              science club\n            </textPath>\n\n            <textPath \n              href=\"#textCurveBottom\" \n              startOffset=\"50%\" \n              textAnchor=\"middle\" \n              className=\"tracking-[0.12em]\" \n              style={{\n                fontSize: \'17px\', \n                fontWeight: 800, \n                fontFamily: \'\"JetBrains Mono\", \"Inter\", monospace\',\n                fill: \'#10b981\', // emerald green to match science club green\n                paintOrder: \'fill\',\n              }}\n            >\n              science club\n            </textPath>\n          </text>\n        </>\n      )}\n    </svg>\n  );\n}"
