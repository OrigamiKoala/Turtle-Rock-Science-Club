      replacement_content: "import React, { useState } from \'react\';\nimport { ClubIdentity, LabLog, Announcement, PressMention, UserProfile } from \'../types\';\nimport { BookOpen, Newspaper, Send, CheckCircle, Mail, Quote, Clock, User, X, MessageSquare, AlertCircle } from \'lucide-react\';\n\ninterface LabLogAnnouncementsProps {\n  identity: ClubIdentity;\n  logs: LabLog[];\n  announcements: Announcement[];\n  press: PressMention[];\n  userProfile: UserProfile;\n  onSubscribeNewsletter: () => void;\n}\n\nexport default function LabLogAnnouncements({\n  identity,\n  logs,\n  announcements,\n  press,\n  userProfile,\n  onSubscribeNewsletter\n}: LabLogAnnouncementsProps) {\n  const isTurtle = identity === \'turtlerock\';\n\n  // Modal / overlay detail state\n  const [activeLogId, setActiveLogId] = useState<string | null>(null);\n  const [newsletterEmail, setNewsletterEmail] = useState(\'\');\n  const [emailSuccess, setEmailSuccess] = useState(false);\n  const [emailError, setEmailError] = useState(\'\');\n\n  // Comment state inside logs\n  const [comments, setComments] = useState<Record<string, Array<{ name: string; text: string; date: string }>>>({\n    \'log-1\': [\n      { name: \'Parent David L.\', text: \'My daughter can not stop talking about the Volcano eruption! The colorful pigments were a huge hit.\', date: \'June 19, 2026\' }\n    ]\n  });\n  const [newCommentName, setNewCommentName] = useState(\'\');\n  const [newCommentText, setNewCommentText] = useState(\'\');\n\n  const activeLog = logs.find((l) => l.id === activeLogId);\n\n  const handleSubscribe = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newsletterEmail || !newsletterEmail.includes(\'@\')) {\n      setEmailError(\'Please enter a valid email address.\');\n      return;\n    }\n\n    setEmailError(\'\');\n    onSubscribeNewsletter();\n    setEmailSuccess(true);\n    setNewsletterEmail(\'\');\n\n    setTimeout(() => {\n      setEmailSuccess(false);\n    }, 4000);\n  };\n\n  const handleAddComment = (e: React.FormEvent, logId: string) => {\n    e.preventDefault();\n    if (!newCommentName || !newCommentText) return;\n\n    const added = {\n      name: newCommentName,\n      text: newCommentText,\n      date: \'Today\'\n    };\n\n    setComments((prev) => ({\n      ...prev,\n      [logId]: [...(prev[logId] || []), added]\n    }));\n\n    setNewCommentName(\'\');\n    setNewCommentText(\'\');\n  };\n\n  return (\n    <section className=\"py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-16 text-left\">\n      \n      {/* SECTION 1: LAB LOGS (Featured journals) */}\n      <div className=\"space-y-8\">\n        <div>\n          <h3 className={`font-display font-bold text-2xl sm:text-3xl tracking-tight ${\n            isTurtle ? \'text-emerald-900\' : \'text-slate-100\'\n          }`}>\n            Latest From the Lab Log\n          </h3>\n          <p className={`text-sm mt-1 ${isTurtle ? \'text-stone-600\' : \'text-slate-400\'}`}>\n            Journal entries and research documentation published by our lead mentors and junior experimenters.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {logs.map((log) => (\n            <div\n              id={`log-card-${log.id}`}\n              key={log.id}\n              className={`rounded-2xl border overflow-hidden flex flex-col justify-between transition hover:shadow-md cursor-pointer ${\n                isTurtle ? \'bg-white border-emerald-100\' : \'bg-slate-900 border-slate-800 text-slate-100\'\n              }`}\n              onClick={() => setActiveLogId(log.id)}\n            >\n              <div className=\"relative h-44 overflow-hidden\">\n                <img src={log.image} alt={log.title} className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n                <span className=\"absolute top-3 right-3 bg-emerald-600 text-white font-mono text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full\">\n                  {log.category}\n                </span>\n              </div>\n\n              <div className=\"p-5 flex-1 flex flex-col justify-between space-y-4\">\n                <div className=\"space-y-1.5\">\n                  <div className=\"flex items-center gap-2 text-[10px] font-mono opacity-70\">\n                    <Clock className=\"w-3.5 h-3.5\" />\n                    <span>{log.date}</span>\n                  </div>\n                  <h4 className=\"font-display font-bold text-base leading-snug tracking-tight hover:underline\">\n                    {log.title}\n                  </h4>\n                  <p className={`text-xs leading-relaxed line-clamp-2 ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n                    {log.summary}\n                  </p>\n                </div>\n\n                <div className=\"pt-3 border-t border-dashed border-stone-100 flex items-center justify-between text-[11px] font-mono\">\n                  <span className=\"opacity-75\">By: {log.author}</span>\n                  <span className=\"text-amber-500 font-bold hover:underline\">Read Entry \342\206\222</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* SECTION 2: ANNOUNCEMENTS & NEWSLETTER SPLIT */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch pt-6 border-t border-slate-200/40\">\n        \n        {/* Left Column: Club Announcements */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          <div className=\"space-y-1\">\n            <h4 className={`font-display font-bold text-xl sm:text-2xl tracking-tight ${\n              isTurtle ? \'text-emerald-900\' : \'text-slate-100\'\n            }`}>\n              Club Announcements\n            </h4>\n            <p className={`text-xs ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n              Stay updated with club expansion project schedules, material check-ins, and safety notifications.\n            </p>\n          </div>\n\n          <div className=\"space-y-4\">\n            {announcements.map((ann) => (\n              <div\n                id={`announcement-${ann.id}`}\n                key={ann.id}\n                className={`p-5 rounded-2xl border space-y-2.5 ${\n                  isTurtle ? \'bg-white border-emerald-100/70\' : \'bg-slate-900 border-slate-800 text-slate-100\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between gap-4\">\n                  <span className={`px-2.5 py-0.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-wider ${\n                    ann.category === \'expansion\' \n                      ? \'bg-purple-100 text-purple-800\' \n                      : ann.category === \'toolkit\'\n                        ? \'bg-blue-100 text-blue-800\'\n                        : \'bg-amber-100 text-stone-900\'\n                  }`}>\n                    {ann.category}\n                  </span>\n                  <span className=\"text-[10px] font-mono opacity-60\">{ann.date}</span>\n                </div>\n                <h5 className=\"font-display font-bold text-sm tracking-tight leading-snug\">\n                  {ann.title}\n                </h5>\n                <p className={`text-xs leading-relaxed ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n                  {ann.content}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right Column: Press & Newsletter Signup */}\n        <div className=\"lg:col-span-5 flex flex-col justify-between gap-6\">\n          \n          {/* Newsletter Box */}\n          <div className={`p-6 rounded-2xl border flex flex-col justify-between space-y-4 ${\n            isTurtle \n              ? \'bg-emerald-50/50 border-emerald-100 text-emerald-900\' \n              : \'bg-indigo-950/40 border-indigo-900/60 text-slate-100\'\n          }`}>\n            <div className=\"space-y-1.5\">\n              <div className=\"p-2 bg-amber-500 text-stone-950 rounded-xl inline-block\">\n                <Mail className=\"w-5 h-5\" />\n              </div>\n              <h5 className=\"font-display font-bold text-lg leading-tight\">\n                Broadcasting Discovery to the Neighborhood\n              </h5>\n              <p className=\"text-xs text-opacity-80 opacity-80 leading-relaxed\">\n                Subscribe to our bi-weekly dispatch. Get illustrated science experiments, stargazing coordinates, and RSVP notifications sent straight to your family inbox!\n              </p>\n            </div>\n\n            {userProfile.newsletterSubscribed ? (\n              <div className=\"p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono font-semibold flex items-center gap-2 text-green-500\">\n                <CheckCircle className=\"w-5 h-5 shrink-0\" />\n                <span>Subscribed! Check inbox for Science Toolkit. (+20 XP Earned)</span>\n              </div>\n            ) : emailSuccess ? (\n              <div className=\"p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono font-semibold flex items-center gap-2 text-green-500 animate-bounce\">\n                <CheckCircle className=\"w-5 h-5 shrink-0\" />\n                <span>Subscription Success! Welcome package sent.</span>\n              </div>\n            ) : (\n              <form onSubmit={handleSubscribe} className=\"space-y-2\">\n                <div className=\"flex gap-2\">\n                  <input\n                    id=\"newsletter-email-input\"\n                    type=\"email\"\n                    placeholder=\"parent-scientist@domain.com\"\n                    value={newsletterEmail}\n                    onChange={(e) => setNewsletterEmail(e.target.value)}\n                    className={`flex-1 px-3 py-2.5 rounded-xl text-xs border ${\n                      isTurtle ? \'bg-white border-emerald-200\' : \'bg-slate-950 border-slate-800\'\n                    }`}\n                    required\n                  />\n                  <button\n                    id=\"newsletter-submit-btn\"\n                    type=\"submit\"\n                    className={`px-4 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1 cursor-pointer ${\n                      isTurtle\n                        ? \'bg-amber-500 hover:bg-amber-400 text-stone-900\'\n                        : \'bg-indigo-600 hover:bg-indigo-500 text-white\'\n                    }`}\n                  >\n                    <span>Join</span>\n                    <Send className=\"w-3 h-3\" />\n                  </button>\n                </div>\n                {emailError && (\n                  <p className=\"text-[10px] text-red-500 font-mono flex items-center gap-1\">\n                    <AlertCircle className=\"w-3.5 h-3.5\" />\n                    {emailError}\n                  </p>\n                )}\n                <p className=\"text-[10px] opacity-60\">We never spam. Unsubscribe at any time with one click.</p>\n              </form>\n            )}\n          </div>\n\n          {/* Press Clips */}\n          <div className=\"space-y-4\">\n            <h5 className={`font-display font-bold text-sm uppercase tracking-wider flex items-center gap-2 ${\n              isTurtle ? \'text-emerald-800\' : \'text-slate-300\'\n            }`}>\n              <Newspaper className=\"w-4 h-4\" />\n              In the News\n            </h5>\n\n            <div className=\"space-y-4\">\n              {press.map((pr) => (\n                <div key={pr.id} className=\"space-y-1.5 pl-3 border-l-2 border-stone-200\">\n                  <p className=\"text-[10px] font-mono opacity-50 flex items-center gap-1.5\">\n                    <span>{pr.source}</span>\n                    <span>\342\200\242</span>\n                    <span>{pr.date}</span>\n                  </p>\n                  <h6 className=\"font-semibold text-xs leading-snug\">\n                    {pr.title}\n                  </h6>\n                  <p className={`text-[11px] leading-relaxed italic ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n                    \"{pr.snippet}\"\n                  </p>\n                </div>\n              ))}\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* OVERLAY / DRILL DOWN LOG DETAIL MODAL */}\n      {activeLog && (\n        <div className=\"fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4\">\n          <div \n            id=\"log-detail-modal\"\n            className={`w-full max-w-2xl rounded-2xl overflow-hidden shadow-2xl border flex flex-col justify-between max-h-[90vh] ${\n              isTurtle ? \'bg-white border-emerald-100 text-stone-900\' : \'bg-slate-900 border-slate-800 text-slate-100\'\n            }`}\n          >\n            {/* Header image & close button */}\n            <div className=\"relative h-60\">\n              <img src={activeLog.image} alt={activeLog.title} className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n              <button\n                id=\"close-log-modal-btn\"\n                onClick={() => setActiveLogId(null)}\n                className=\"absolute top-4 right-4 p-2 bg-black/50 hover:bg-black/70 text-white rounded-full transition-all cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-6\">\n                <div className=\"text-white space-y-1\">\n                  <span className=\"bg-emerald-600 text-[9px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full\">\n                    {activeLog.category}\n                  </span>\n                  <h3 className=\"font-display font-bold text-lg sm:text-2xl tracking-tight leading-tight\">\n                    {activeLog.title}\n                  </h3>\n                </div>\n              </div>\n            </div>\n\n            {/* Scrollable content body */}\n            <div className=\"p-6 overflow-y-auto space-y-6 flex-1\">\n              {/* Author & date metadata bar */}\n              <div className=\"flex items-center gap-4 text-xs font-mono opacity-70 border-b border-dashed pb-4\">\n                <div className=\"flex items-center gap-1\">\n                  <User className=\"w-4 h-4\" />\n                  <span>{activeLog.author}</span>\n                </div>\n                <span>\342\200\242</span>\n                <div className=\"flex items-center gap-1\">\n                  <Clock className=\"w-4 h-4\" />\n                  <span>{activeLog.date}</span>\n                </div>\n              </div>\n\n              {/* Main Log paragraphs */}\n              <p className=\"text-xs leading-relaxed font-sans font-medium\">\n                {activeLog.content}\n              </p>\n\n              {/* Comments Board inside Log */}\n              <div className=\"space-y-4 pt-6 border-t\">\n                <h5 className=\"font-display font-bold text-sm flex items-center gap-1.5\">\n                  <MessageSquare className=\"w-4.5 h-4.5\" />\n                  Discussion ({comments[activeLog.id]?.length || 0})\n                </h5>\n\n                <div className=\"space-y-3\">\n                  {(comments[activeLog.id] || []).map((comm, index) => (\n                    <div \n                      key={index} \n                      className={`p-3.5 rounded-xl border text-xs space-y-1 ${\n                        isTurtle ? \'bg-slate-50 border-slate-200\' : \'bg-slate-950 border-slate-800\'\n                      }`}\n                    >\n                      <div className=\"flex items-center justify-between font-mono text-[10px] opacity-75\">\n                        <span className=\"font-bold\">{comm.name}</span>\n                        <span>{comm.date}</span>\n                      </div>\n                      <p className=\"leading-relaxed text-opacity-90\">{comm.text}</p>\n                    </div>\n                  ))}\n                </div>\n\n                {/* Comment Submission Form */}\n                <form onSubmit={(e) => handleAddComment(e, activeLog.id)} className=\"space-y-2 pt-2\">\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                    <input\n                      id=\"comment-name-input\"\n                      type=\"text\"\n                      placeholder=\"Your Name / Title\"\n                      value={newCommentName}\n                      onChange={(e) => setNewCommentName(e.target.value)}\n                      className={`p-2 rounded-xl text-xs border ${\n                        isTurtle ? \'bg-white border-emerald-200\' : \'bg-slate-950 border-slate-800\'\n                      }`}\n                      required\n                    />\n                  </div>\n                  <div className=\"flex gap-2\">\n                    <input\n                      id=\"comment-text-input\"\n                      type=\"text\"\n                      placeholder=\"Add to the discovery discussion...\"\n                      value={newCommentText}\n                      onChange={(e) => setNewCommentText(e.target.value)}\n                      className={`flex-1 p-2 rounded-xl text-xs border ${\n                        isTurtle ? \'bg-white border-emerald-200\' : \'bg-slate-950 border-slate-800\'\n                      }`}\n                      required\n                    />\n                    <button\n                      id=\"comment-submit-btn\"\n                      type=\"submit\"\n                      className={`px-3 py-2 rounded-xl text-xs font-bold cursor-pointer ${\n                        isTurtle ? \'bg-emerald-600 text-white\' : \'bg-indigo-600 text-white\'\n                      }`}\n                    >\n                      Comment\n                    </button>\n                  </div>\n                </form>\n              </div>\n            </div>\n\n            {/* Bottom action panel */}\n            <div className=\"p-4 border-t bg-slate-50/50 flex justify-end\">\n              <button\n                id=\"close-log-footer-btn\"\n                onClick={() => setActiveLogId(null)}\n                className=\"px-4 py-2 bg-stone-300 text-stone-800 text-xs font-bold rounded-xl hover:bg-stone-400 transition cursor-pointer\"\n              >\n                Close Journal\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </section>\n  );\n}\n"
    }
