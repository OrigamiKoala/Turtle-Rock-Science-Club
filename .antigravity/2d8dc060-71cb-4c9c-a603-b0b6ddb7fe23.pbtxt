      target_content: "  return (\n    <section className=\"py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-10 text-left\">\n      \n      {/* Grid: Profile detail & XP Progress (Top) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Profile Card & Customization */}\n        <div className={`lg:col-span-4 rounded-2xl p-6 border flex flex-col justify-between space-y-6 ${\n          isTurtle ? \'bg-white border-emerald-100 shadow-sm\' : \'bg-slate-900 border-slate-800 text-slate-100\'\n        }`}>\n          \n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"w-16 h-16 rounded-2xl bg-gradient-to-tr from-indigo-500 to-violet-600 text-white flex items-center justify-center font-bold text-3xl shadow-md ring-4 ring-indigo-300\">\n                {userProfile.name[0].toUpperCase()}\n              </div>\n              <div className=\"text-left\">\n                <h4 className=\"font-display font-bold text-lg leading-tight\">{userProfile.name}</h4>\n                <p className=\"text-xs text-amber-500 font-bold mt-1 font-mono\">{getScientistTitle()}</p>\n                <p className={`text-[10px] ${isTurtle ? \'text-stone-400\' : \'text-slate-400\'}`}>Joined: {userProfile.joinedDate}</p>\n              </div>\n            </div>\n \n            {/* Level & XP progression bar */}\n            <div className=\"space-y-2 pt-4 border-t border-slate-200/50\">\n              <div className=\"flex justify-between items-center text-xs font-mono\">\n                <span className=\"flex items-center gap-1\">\n                  <Trophy className=\"w-4 h-4 text-yellow-500\" />\n                  Scientist Level {userProfile.level}\n                </span>\n                <span className=\"font-semibold text-stone-400\">{xpInCurrentLevel}/100 XP</span>\n              </div>\n              <div className=\"w-full bg-slate-200 h-2.5 rounded-full overflow-hidden\">\n                <div \n                  className={`h-full rounded-full transition-all duration-500 ${\n                    isTurtle ? \'bg-emerald-600\' : \'bg-indigo-600\'\n                  }`}\n                  style={{ width: `${xpPercent}%` }}\n                />\n              </div>\n              <p className=\"text-[10px] text-stone-400 font-mono\">Accumulated Lifetime Points: {userProfile.xp} XP</p>\n            </div>\n          </div>\n \n          {/* Edit Name Inline Form */}\n          <form onSubmit={handleSaveName} className=\"space-y-2 pt-4 border-t border-dashed border-stone-200/50\">\n            <label className=\"text-[10px] font-bold font-mono tracking-wider uppercase text-stone-400\">Scientist Pseudonym</label>\n            <div className=\"flex gap-2\">\n              <input\n                id=\"profile-name-edit\"\n                type=\"text\"\n                value={editName}\n                onChange={(e) => setEditName(e.target.value)}\n                maxLength={20}\n                className={`flex-1 p-2 rounded-xl text-xs border ${\n                  isTurtle ? \'bg-white border-emerald-100 text-stone-900\' : \'bg-slate-950 border-slate-800 text-slate-100\'\n                }`}\n              />\n              <button\n                id=\"save-profile-name-btn\"\n                type=\"submit\"\n                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${\n                  isTurtle ? \'bg-emerald-600 text-white hover:bg-emerald-500\' : \'bg-indigo-600 text-white hover:bg-indigo-500\'\n                }`}\n              >\n                Save\n              </button>\n            </div>\n            {showEditMsg && (\n              <p className=\"text-[10px] text-green-500 font-mono flex items-center gap-1 mt-1\">\n                <CheckCircle className=\"w-3.5 h-3.5\" />\n                Scientist record updated!\n              </p>\n            )}\n          </form>\n \n        </div>\n \n        {/* Badge & Achievements Grid */}\n        <div className=\"lg:col-span-8 space-y-4\">\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Award className=\"w-5.5 h-5.5 text-yellow-500\" />\n            <h4 className={`font-display font-bold text-lg tracking-tight ${\n              isTurtle ? \'text-emerald-950\' : \'text-slate-100\'\n            }`}>\n              Scientist Achievements ({userProfile.unlockedBadges.length} of {badgeCatalog.length})\n            </h4>\n          </div>\n \n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {badgeCatalog.map((badge, idx) => {\n              const isUnlocked = userProfile.unlockedBadges.includes(badge.name);\n              const Icon = badge.icon;\n \n              return (\n                <div\n                  id={`badge-card-${idx}`}\n                  key={badge.name}\n                  className={`p-4 rounded-2xl border transition-all duration-300 flex items-start gap-4 ${\n                    isUnlocked\n                      ? isTurtle\n                        ? \'bg-white border-emerald-100 shadow-sm\'\n                        : \'bg-slate-900 border-indigo-950 text-slate-100\'\n                      : \'opacity-50 grayscale border-dashed border-stone-200\'\n                  }`}\n                >\n                  <div className={`p-3 rounded-xl shrink-0 ${\n                    isUnlocked ? badge.color : \'bg-stone-100 text-stone-400\'\n                  }`}>\n                    <Icon className=\"w-6 h-6\" />\n                  </div>\n                  <div className=\"text-left space-y-1\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <h5 className=\"font-bold text-xs\">{badge.name}</h5>\n                      {isUnlocked && (\n                        <span className=\"text-[8px] font-mono px-1.5 py-0.5 rounded-full bg-yellow-100 text-yellow-800 font-bold\">\n                          UNLOCKED\n                        </span>\n                      )}\n                    </div>\n                    <p className={`text-[10px] leading-relaxed ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n                      {badge.desc}\n                    </p>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n \n      </div>\n \n      {/* Bench Reservations list (Bottom) */}\n      <div className=\"space-y-6 pt-6 border-t border-slate-200/50\">\n        <div>\n          <h4 className={`font-display font-bold text-xl tracking-tight flex items-center gap-2 ${\n            isTurtle ? \'text-emerald-900\' : \'text-slate-100\'\n          }`}>\n            <Ticket className=\"w-5.5 h-5.5 text-amber-500\" />\n            Your Reserved Stations & Benches\n          </h4>\n          <p className=\"text-xs text-stone-400 mt-1\">Manage physical hardware slots reserved in our local sessions.</p>\n        </div>\n \n        {reservedMissions.length > 0 ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {reservedMissions.map((mission) => (\n              <div\n                id={`reservation-card-${mission.id}`}\n                key={mission.id}\n                className={`p-4 rounded-xl border flex gap-4 justify-between items-center ${\n                  isTurtle ? \'bg-white border-emerald-100\' : \'bg-slate-900 border-slate-800 text-slate-100\'\n                }`}\n              >\n                <div className=\"flex gap-3 items-center min-w-0\">\n                  <img src={mission.image} alt=\"\" className=\"w-12 h-12 rounded-lg object-cover\" />\n                  <div className=\"text-left min-w-0\">\n                    <h5 className=\"font-bold text-xs truncate leading-snug\">{mission.title}</h5>\n                    <p className=\"text-[10px] text-stone-400 font-mono mt-0.5 flex items-center gap-1\">\n                      <Clock className=\"w-3 h-3 shrink-0\" />\n                      {mission.date} \342\200\242 {mission.time}\n                    </p>\n                  </div>\n                </div>\n \n                <button\n                  id={`cancel-reservation-btn-${mission.id}`}\n                  onClick={() => onCancelReserve(mission.id)}\n                  className=\"px-3 py-1.5 rounded-lg text-[10px] font-mono font-bold text-red-500 hover:bg-red-50 transition shrink-0 cursor-pointer\"\n                >\n                  Release Station\n                </button>\n              </div>\n            ))}\n          </div>\n        ) : (\n          <div className=\"py-12 text-center border-2 border-dashed border-stone-200 rounded-2xl\">\n            <Calendar className=\"w-12 h-12 text-stone-300 mx-auto mb-2\" />\n            <p className=\"font-semibold text-stone-500 text-sm\">No benches reserved yet</p>\n            <p className=\"text-xs text-stone-400 max-w-sm mx-auto mt-1\">\n              Benches fill up fast! Explore upcoming workshops and book a station for your child.\n            </p>\n            <button\n              id=\"dashboard-explore-btn\"\n              onClick={() => setCurrentTab(\'missions\')}\n              className={`px-4 py-2 text-xs font-bold rounded-xl shadow-xs transition-all hover:scale-105 active:scale-95 cursor-pointer mt-4 ${\n                isTurtle ? \'bg-emerald-600 text-white\' : \'bg-indigo-600 text-white\'\n              }`}\n            >\n              Browse Active Missions\n            </button>\n          </div>\n        )}\n      </div>\n \n    </section>"
      replacement_content: "  return (\n    <section className=\"py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-10 text-left relative z-10 font-sans\">\n      \n      {/* Grid: Profile detail & XP Progress (Top) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Profile Card & Customization */}\n        <div className=\"lg:col-span-4 rounded-[2rem] p-6 border border-white/10 bg-zinc-900/40 backdrop-blur-md flex flex-col justify-between space-y-6 shadow-2xl text-white\">\n          \n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"w-16 h-16 rounded-2xl bg-zinc-950 text-white border border-white/10 flex items-center justify-center font-bold text-3xl shadow-lg font-mono\">\n                {userProfile.name[0].toUpperCase()}\n              </div>\n              <div className=\"text-left\">\n                <h4 className=\"font-display font-bold text-lg leading-tight text-white tracking-tighter\">{userProfile.name}</h4>\n                <p className={`text-xs font-bold mt-1 font-mono uppercase tracking-widest ${\n                  isTurtle ? \'text-emerald-400\' : \'text-blue-400\'\n                }`}>{getScientistTitle()}</p>\n                <p className=\"text-[10px] text-zinc-500 font-mono mt-0.5\">Joined: {userProfile.joinedDate}</p>\n              </div>\n            </div>\n\n            {/* Level & XP progression bar */}\n            <div className=\"space-y-2 pt-4 border-t border-white/10\">\n              <div className=\"flex justify-between items-center text-[10px] font-mono uppercase tracking-widest text-zinc-400\">\n                <span className=\"flex items-center gap-1\">\n                  <Trophy className=\"w-4 h-4 text-amber-500\" />\n                  Level {userProfile.level}\n                </span>\n                <span className=\"font-bold text-zinc-500\">{xpInCurrentLevel}/100 XP</span>\n              </div>\n              <div className=\"w-full bg-zinc-950 h-2.5 rounded-full overflow-hidden border border-white/5\">\n                <div \n                  className={`h-full rounded-full transition-all duration-500 shadow-md ${\n                    isTurtle \n                      ? \'bg-emerald-500 shadow-emerald-500/20\' \n                      : \'bg-blue-500 shadow-blue-500/20\'\n                  }`}\n                  style={{ width: `${xpPercent}%` }}\n                />\n              </div>\n              <p className=\"text-[9px] text-zinc-500 font-mono uppercase tracking-widest\">Lifetime Accumulated: {userProfile.xp} XP</p>\n            </div>\n          </div>\n\n          {/* Edit Name Inline Form */}\n          <form onSubmit={handleSaveName} className=\"space-y-2 pt-4 border-t border-dashed border-white/10\">\n            <label className=\"text-[10px] font-bold font-mono tracking-widest uppercase text-zinc-500\">Scientist Pseudonym</label>\n            <div className=\"flex gap-2\">\n              <input\n                id=\"profile-name-edit\"\n                type=\"text\"\n                value={editName}\n                onChange={(e) => setEditName(e.target.value)}\n                maxLength={20}\n                className=\"flex-1 p-2 rounded-xl text-xs border border-white/10 bg-zinc-950/60 text-white focus:outline-none focus:border-white/20\"\n              />\n              <button\n                id=\"save-profile-name-btn\"\n                type=\"submit\"\n                className=\"px-4 py-1.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-widest transition cursor-pointer bg-white/5 hover:bg-white/10 text-zinc-300 border border-white/10\"\n              >\n                Save\n              </button>\n            </div>\n            {showEditMsg && (\n              <p className=\"text-[10px] text-emerald-400 font-mono flex items-center gap-1 mt-1 uppercase tracking-wide\">\n                <CheckCircle className=\"w-3.5 h-3.5\" />\n                Scientist record updated!\n              </p>\n            )}\n          </form>\n\n        </div>\n\n        {/* Badge & Achievements Grid */}\n        <div className=\"lg:col-span-8 space-y-4\">\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Award className=\"w-5.5 h-5.5 text-yellow-500\" />\n            <h4 className=\"font-display font-bold text-lg tracking-tighter text-white\">\n              Scientist Achievements ({userProfile.unlockedBadges.length} of {badgeCatalog.length})\n            </h4>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {badgeCatalog.map((badge, idx) => {\n              const isUnlocked = userProfile.unlockedBadges.includes(badge.name);\n              const Icon = badge.icon;\n\n              // Customize colors for dark mode bento themes\n              const badgeColors: Record<string, string> = {\n                \'Foundation Member\': \'text-emerald-400 bg-emerald-950/40 border border-emerald-500/20\',\n                \'Lava Lamp Alchemist\': \'text-amber-400 bg-amber-950/40 border border-amber-500/20\',\n                \'Volcano Catalyst\': \'text-red-400 bg-red-950/40 border border-red-500/20\',\n                \'Stargazing Scout\': \'text-blue-400 bg-blue-950/40 border border-blue-500/20\'\n              };\n\n              const activeStyle = badgeColors[badge.name] || \'text-zinc-400 bg-zinc-950 border border-white/10\';\n\n              return (\n                <div\n                  id={`badge-card-${idx}`}\n                  key={badge.name}\n                  className={`p-4 rounded-2xl border transition-all duration-300 flex items-start gap-4 ${\n                    isUnlocked\n                      ? \'border-white/10 bg-zinc-900/40 backdrop-blur-md text-white shadow-xl hover:border-white/20\'\n                      : \'opacity-35 grayscale border-dashed border-white/5 bg-zinc-950/10\'\n                  }`}\n                >\n                  <div className={`p-3 rounded-xl shrink-0 ${\n                    isUnlocked ? activeStyle : \'bg-zinc-950/80 text-zinc-600 border border-white/5\'\n                  }`}>\n                    <Icon className=\"w-5 h-5\" />\n                  </div>\n                  <div className=\"text-left space-y-1\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <h5 className=\"font-display font-bold text-xs text-white leading-none\">{badge.name}</h5>\n                      {isUnlocked && (\n                        <span className=\"text-[8px] font-mono px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 font-bold uppercase tracking-wider\">\n                          UNLOCKED\n                        </span>\n                      )}\n                    </div>\n                    <p className=\"text-[10px] leading-relaxed text-zinc-400\">\n                      {badge.desc}\n                    </p>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n      </div>\n\n      {/* Bench Reservations list (Bottom) */}\n      <div className=\"space-y-6 pt-6 border-t border-white/5\">\n        <div>\n          <h4 className=\"font-display font-bold text-xl tracking-tighter flex items-center gap-2 text-white\">\n            <Ticket className=\"w-5.5 h-5.5 text-amber-500\" />\n            Your Reserved Stations & Benches\n          </h4>\n          <p className=\"text-xs text-zinc-400 mt-1\">Manage physical hardware slots reserved in our local sessions.</p>\n        </div>\n\n        {reservedMissions.length > 0 ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {reservedMissions.map((mission) => (\n              <div\n                id={`reservation-card-${mission.id}`}\n                key={mission.id}\n                className=\"p-4 rounded-[2rem] border border-white/10 bg-zinc-900/40 backdrop-blur-md flex gap-4 justify-between items-center text-white hover:border-white/20 hover:shadow-xl transition\"\n              >\n                <div className=\"flex gap-3 items-center min-w-0\">\n                  <img src={mission.image} alt=\"\" className=\"w-12 h-12 rounded-lg object-cover\" />\n                  <div className=\"text-left min-w-0\">\n                    <h5 className=\"font-display font-bold text-xs truncate leading-snug text-white\">{mission.title}</h5>\n                    <p className=\"text-[9px] text-zinc-500 font-mono mt-0.5 flex items-center gap-1 uppercase tracking-wider\">\n                      <Clock className=\"w-3 h-3 shrink-0\" />\n                      {mission.date} \342\200\242 {mission.time}\n                    </p>\n                  </div>\n                </div>\n\n                <button\n                  id={`cancel-reservation-btn-${mission.id}`}\n                  onClick={() => onCancelReserve(mission.id)}\n                  className=\"px-3 py-1.5 rounded-full text-[9px] font-mono font-bold uppercase tracking-widest text-red-400 border border-red-500/10 hover:bg-red-500/10 hover:border-red-500/20 transition shrink-0 cursor-pointer\"\n                >\n                  Release Station\n                </button>\n              </div>\n            ))}\n          </div>\n        ) : (\n          <div className=\"py-12 text-center border border-dashed border-white/10 rounded-[2rem] bg-zinc-900/20 text-white\">\n            <Calendar className=\"w-10 h-10 text-zinc-600 mx-auto mb-2\" />\n            <p className=\"font-mono font-bold text-xs uppercase tracking-widest text-zinc-400\">No benches reserved yet</p>\n            <p className=\"text-xs text-zinc-500 max-w-sm mx-auto mt-1 leading-relaxed\">\n              Benches fill up fast! Explore upcoming workshops and book a station for your child.\n            </p>\n            <button\n              id=\"dashboard-explore-btn\"\n              onClick={() => setCurrentTab(\'missions\')}\n              className={`px-5 py-2.5 text-[10px] font-mono font-bold uppercase tracking-widest rounded-full shadow-md transition-all hover:scale-105 active:scale-95 cursor-pointer mt-4 ${\n                isTurtle ? \'bg-emerald-500 hover:bg-emerald-400 text-stone-950\' : \'bg-blue-500 hover:bg-blue-400 text-stone-950\'\n              }`}\n            >\n              Browse Active Missions\n            </button>\n          </div>\n        )}\n      </div>\n\n    </section>\n  );"
    }
    instruction: "Modify Dashboard to style with translucent borders, clean XP tracker bar, and sleek badges/reservations list."
  }
}
