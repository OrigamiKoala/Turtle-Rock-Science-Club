    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ClubIdentity, UserProfile } from \'../types\';\nimport { Sparkles, ArrowRight, Shield, Award, Users, GraduationCap, Zap } from \'lucide-react\';\n\ninterface HeroSectionProps {\n  identity: ClubIdentity;\n  userProfile: UserProfile;\n  onOpenJoin: () => void;\n  setCurrentTab: (tab: string) => void;\n}\n\nexport default function HeroSection({\n  identity,\n  userProfile,\n  onOpenJoin,\n  setCurrentTab\n}: HeroSectionProps) {\n  const isTurtle = identity === \'turtlerock\';\n\n  return (\n    <div className={`relative overflow-hidden pt-12 pb-16 transition-all duration-300 ${\n      isTurtle \n        ? \'bg-gradient-to-b from-emerald-50 via-teal-50/40 to-white\' \n        : \'bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-white\'\n    }`}>\n      \n      {/* Background Decorative Accents */}\n      <div className=\"absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none\" />\n      <div className=\"absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl opacity-20 pointer-events-none\" \n        style={{\n          background: isTurtle \n            ? \'radial-gradient(circle, #059669 0%, transparent 70%)\' \n            : \'radial-gradient(circle, #4f46e5 0%, transparent 70%)\'\n        }}\n      />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        <div className=\"text-center max-w-3xl mx-auto space-y-6\">\n          \n          {/* Animated Little Pill Badging */}\n          <div className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wide border shadow-xs animate-bounce\"\n            style={{\n              backgroundColor: isTurtle ? \'#d1fae5\' : \'#1e1b4b\',\n              color: isTurtle ? \'#065f46\' : \'#a5b4fc\',\n              borderColor: isTurtle ? \'#a7f3d0\' : \'#312e81\'\n            }}\n          >\n            {isTurtle ? <span className=\"text-sm\">\360\237\220\242</span> : <Zap className=\"w-3.5 h-3.5\" />}\n            <span>\n              {isTurtle \n                ? \'Join Turtle Rock Valley\342\200\231s Premier Science Club\' \n                : \'Kinetic Methodology & Science Discovery Lab\'}\n            </span>\n          </div>\n\n          {/* Core Captivating Heading */}\n          <h2 className=\"font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.1]\">\n            {isTurtle ? (\n              <>\n                Discover the <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500\">Magic of Science</span> Together\n              </>\n            ) : (\n              <>\n                Unlock the <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-400\">Mysteries</span> of the Universe\n              </>\n            )}\n          </h2>\n\n          {/* Descriptive Subtitle */}\n          <p className={`text-base sm:text-lg max-w-2xl mx-auto leading-relaxed ${\n            isTurtle ? \'text-stone-600\' : \'text-slate-300\'\n          }`}>\n            {isTurtle \n              ? \'Founded by local parents, we make advanced chemistry, astronomy, and robotics collaborative and accessible for inquisitive minds. Where friendships and lifelong discoveries are born!\'\n              : \'Empowering children with rigorous experimental design and high-level technical frameworks. We train future researchers through disciplined science and meticulous analytical standards.\'}\n          </p>\n\n          {/* Action CTAs */}\n          <div className=\"flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-4\">\n            {userProfile.level === 0 ? (\n              <button\n                id=\"hero-join-cta-btn\"\n                onClick={onOpenJoin}\n                className={`w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-base shadow-lg transition-all duration-300 hover:scale-[1.02] active:scale-95 cursor-pointer flex items-center justify-center gap-2 ${\n                  isTurtle\n                    ? \'bg-amber-500 text-stone-950 hover:bg-amber-400 hover:shadow-amber-500/20\'\n                    : \'bg-indigo-600 text-white hover:bg-indigo-500 hover:shadow-indigo-500/20\'\n                }`}\n              >\n                <span>Join This Mission</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            ) : (\n              <button\n                id=\"hero-lab-cta-btn\"\n                onClick={() => setCurrentTab(\'lab\')}\n                className={`w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-base shadow-lg transition-all duration-300 hover:scale-[1.02] active:scale-95 cursor-pointer flex items-center justify-center gap-2 ${\n                  isTurtle\n                    ? \'bg-emerald-600 text-white hover:bg-emerald-500\'\n                    : \'bg-indigo-600 text-white hover:bg-indigo-500\'\n                }`}\n              >\n                <span>Enter Virtual Lab Room</span>\n                <Atom className=\"w-4 h-4 animate-spin-slow\" />\n              </button>\n            )}\n\n            <button\n              id=\"hero-learn-more-btn\"\n              onClick={() => setCurrentTab(\'about\')}\n              className={`w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-sm transition-all border cursor-pointer ${\n                isTurtle\n                  ? \'bg-white hover:bg-stone-50 text-stone-700 border-stone-200 shadow-xs\'\n                  : \'bg-slate-900 hover:bg-slate-800 text-slate-200 border-slate-800\'\n              }`}\n            >\n              Read Our Story & FAQ\n            </button>\n          </div>\n\n          {/* Core Club Values Badges */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-10 max-w-4xl mx-auto text-left\">\n            <div className={`p-4 rounded-xl border transition-all ${\n              isTurtle \n                ? \'bg-white/80 border-emerald-100 shadow-xs hover:border-emerald-200\' \n                : \'bg-slate-900/60 border-slate-800 hover:border-slate-700\'\n            }`}>\n              <div className=\"flex items-center gap-3\">\n                <div className={`p-2 rounded-lg ${isTurtle ? \'bg-emerald-100 text-emerald-700\' : \'bg-indigo-950 text-indigo-400\'}`}>\n                  <Users className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h4 className=\"font-semibold text-sm font-display\">{isTurtle ? \'Community Bound\' : \'Structured Teams\'}</h4>\n                  <p className={`text-xs mt-0.5 ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n                    {isTurtle ? \'Form lifelong peer bonds.\' : \'Collaborative project cohorts.\'}\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            <div className={`p-4 rounded-xl border transition-all ${\n              isTurtle \n                ? \'bg-white/80 border-emerald-100 shadow-xs hover:border-emerald-200\' \n                : \'bg-slate-900/60 border-slate-800 hover:border-slate-700\'\n            }`}>\n              <div className=\"flex items-center gap-3\">\n                <div className={`p-2 rounded-lg ${isTurtle ? \'bg-amber-100 text-amber-700\' : \'bg-violet-950 text-violet-400\'}`}>\n                  <Award className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h4 className=\"font-semibold text-sm font-display\">Hands-On Curiosity</h4>\n                  <p className={`text-xs mt-0.5 ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n                    We learn purely by active building.\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            <div className={`p-4 rounded-xl border transition-all ${\n              isTurtle \n                ? \'bg-white/80 border-emerald-100 shadow-xs hover:border-emerald-200\' \n                : \'bg-slate-900/60 border-slate-800 hover:border-slate-700\'\n            }`}>\n              <div className=\"flex items-center gap-3\">\n                <div className={`p-2 rounded-lg ${isTurtle ? \'bg-red-100 text-red-700\' : \'bg-red-950 text-red-400\'}`}>\n                  <Shield className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h4 className=\"font-semibold text-sm font-display\">Safety Certified</h4>\n                  <p className={`text-xs mt-0.5 ${isTurtle ? \'text-stone-500\' : \'text-slate-400\'}`}>\n                    Double-safe child testing gear.\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n    </div>\n  );\n}\n"
    }
